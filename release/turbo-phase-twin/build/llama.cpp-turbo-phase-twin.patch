+static bool ggml_sycl_future_moe_gate_up_uses_src(
+    const ggml_cgraph * cgraph, int node_idx, const ggml_tensor * src) {
+    if (!src) {
+        return false;
+    }
+
+    const int last = cgraph->n_nodes - 3;
+    const int end  = node_idx + 40 < last ? node_idx + 40 : last;
+    for (int i = node_idx + 2; i <= end; ++i) {
+        const ggml_tensor * up   = cgraph->nodes[i];
+        const ggml_tensor * gate = cgraph->nodes[i + 1];
+        const ggml_tensor * glu  = cgraph->nodes[i + 2];
+        if (!ggml_sycl_should_fuse_moe_gate_up_swiglu(up, gate, glu)) {
+            continue;
+        }
+        const ggml_tensor * src1 = up->src[1];
+        if (ggml_sycl_tensor_matches_cached_q8_src(src1, src)) {
+            return true;
+        }
+    }
+    return false;
+}
