+static bool ggml_sycl_moe_shared_gate_tail_f32_vec4(
+    const ggml_tensor * shexp, const ggml_tensor * gate,
+    const ggml_tensor * moe, const ggml_tensor * residual,
+    ggml_tensor * dst, dpct::queue_ptr stream) {
+    if (dst->nb[0] != (int64_t) sizeof(float) ||
+        shexp->nb[0] != (int64_t) sizeof(float) ||
+        moe->nb[0] != (int64_t) sizeof(float) ||
+        residual->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+
+    const float * shexp_data    = (const float *) shexp->data;
+    const float * gate_data     = (const float *) gate->data;
+    const float * moe_data      = (const float *) moe->data;
+    const float * residual_data = (const float *) residual->data;
+    float * out                 = (float *) dst->data;
+
+    stream->parallel_for(sycl::range<1>(512), [=](sycl::id<1> tid) {
+        const size_t row = tid[0] * 4;
+        const sycl::float4 shexp_v    = *(const sycl::float4 *) (shexp_data + row);
+        const sycl::float4 moe_v      = *(const sycl::float4 *) (moe_data + row);
+        const sycl::float4 residual_v = *(const sycl::float4 *) (residual_data + row);
+        *(sycl::float4 *) (out + row) = moe_v + shexp_v * gate_data[0] + residual_v;
+    });
+    return true;
+}
