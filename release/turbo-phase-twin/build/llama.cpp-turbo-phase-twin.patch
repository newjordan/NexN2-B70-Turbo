+static bool ggml_sycl_is_nx2_f32_vector(const ggml_tensor * t);
+
+static int ggml_sycl_try_fuse_moe_weighted_sum(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_weighted_sum_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (node_idx + 7 >= cgraph->n_nodes) {
+        return 0;
+    }
+
+    ggml_tensor * mul = cgraph->nodes[node_idx];
+    if (!mul || mul->op != GGML_OP_MUL || (mul->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    if (mul->type != GGML_TYPE_F32 ||
+        mul->ne[0] != 2048 || mul->ne[1] != 8 || mul->ne[2] != 1 || mul->ne[3] != 1 ||
+        mul->nb[0] != (int64_t) sizeof(float) || mul->nb[1] != 2048 * (int64_t) sizeof(float)) {
+        return 0;
+    }
+
+    const ggml_tensor * weighted = nullptr;
+    const ggml_tensor * weights  = nullptr;
+    for (int src_idx = 0; src_idx < 2; ++src_idx) {
+        const ggml_tensor * src = mul->src[src_idx];
+        if (!src || src->type != GGML_TYPE_F32) {
+            return 0;
+        }
+        if (src->op == GGML_OP_MUL_MAT_ID &&
+            src->ne[0] == 2048 && src->ne[1] == 8 && src->ne[2] == 1 && src->ne[3] == 1 &&
+            src->nb[0] == (int64_t) sizeof(float) && src->nb[1] == 2048 * (int64_t) sizeof(float)) {
+            weighted = src;
+        } else if (src->ne[0] == 1 && src->ne[1] == 8 && src->ne[2] == 1 && src->ne[3] == 1 &&
+            src->nb[0] == (int64_t) sizeof(float)) {
+            weights = src;
+        }
+    }
+    if (!weighted || !weights) {
+        return 0;
+    }
+
+    bool seen[8] = {};
+    ggml_tensor * prev = nullptr;
+    for (int add_idx = 0; add_idx < 7; ++add_idx) {
+        ggml_tensor * add = cgraph->nodes[node_idx + 1 + add_idx];
+        if (!add || add->op != GGML_OP_ADD || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return 0;
+        }
+        if (add->type != GGML_TYPE_F32 ||
+            add->ne[0] != 2048 || add->ne[1] != 1 || add->ne[2] != 1 || add->ne[3] != 1 ||
+            add->nb[0] != (int64_t) sizeof(float)) {
+            return 0;
+        }
+
+        const ggml_tensor * view = nullptr;
+        if (add_idx == 0) {
+            if (!ggml_sycl_moe_weighted_sum_view_index(add->src[0], mul, seen) ||
+                !ggml_sycl_moe_weighted_sum_view_index(add->src[1], mul, seen)) {
+                return 0;
+            }
+        } else {
+            if (add->src[0] == prev) {
+                view = add->src[1];
+            } else if (add->src[1] == prev) {
+                view = add->src[0];
+            } else {
+                return 0;
+            }
+            if (!ggml_sycl_moe_weighted_sum_view_index(view, mul, seen)) {
+                return 0;
+            }
+        }
+        prev = add;
+    }
+
+    for (int i = 0; i < 8; ++i) {
+        if (!seen[i]) {
+            return 0;
+        }
+    }
+
+    ggml_tensor * dst = cgraph->nodes[node_idx + 7];
+    if (!dst || !ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 8, node_idx + 7)) {
+        return 0;
+    }
+
+    if (g_ggml_sycl_enable_moe_weighted_sum_fusion == 2) {
+        return ggml_sycl_moe_weighted_sum_8_f32_vec4(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+    }
+    if (g_ggml_sycl_enable_moe_weighted_sum_fusion == 3) {
+        return ggml_sycl_moe_weighted_sum_8_f32_local_weights(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+    }
+    if (g_ggml_sycl_enable_moe_weighted_sum_fusion == 4) {
+        return ggml_sycl_moe_weighted_sum_8_f32_vec8(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+    }
+
+    return ggml_sycl_moe_weighted_sum_8_f32(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+}
+
+static int ggml_sycl_try_fuse_moe_weighted_tail(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_weighted_tail_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (node_idx + 9 >= cgraph->n_nodes) {
+        return 0;
+    }
+
+    ggml_tensor * mul = cgraph->nodes[node_idx];
+    if (!mul || mul->op != GGML_OP_MUL || (mul->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    if (mul->type != GGML_TYPE_F32 ||
+        mul->ne[0] != 2048 || mul->ne[1] != 8 || mul->ne[2] != 1 || mul->ne[3] != 1 ||
+        mul->nb[0] != (int64_t) sizeof(float) || mul->nb[1] != 2048 * (int64_t) sizeof(float)) {
+        return 0;
+    }
+
+    const ggml_tensor * weighted = nullptr;
+    const ggml_tensor * weights  = nullptr;
+    for (int src_idx = 0; src_idx < 2; ++src_idx) {
+        const ggml_tensor * src = mul->src[src_idx];
+        if (!src || src->type != GGML_TYPE_F32) {
+            return 0;
+        }
+        if (src->op == GGML_OP_MUL_MAT_ID &&
+            src->ne[0] == 2048 && src->ne[1] == 8 && src->ne[2] == 1 && src->ne[3] == 1 &&
+            src->nb[0] == (int64_t) sizeof(float) && src->nb[1] == 2048 * (int64_t) sizeof(float)) {
+            weighted = src;
+        } else if (src->ne[0] == 1 && src->ne[1] == 8 && src->ne[2] == 1 && src->ne[3] == 1 &&
+            src->nb[0] == (int64_t) sizeof(float)) {
+            weights = src;
+        }
+    }
+    if (!weighted || !weights) {
+        return 0;
+    }
+
+    bool seen[8] = {};
+    ggml_tensor * prev = nullptr;
+    for (int add_idx = 0; add_idx < 7; ++add_idx) {
+        ggml_tensor * add = cgraph->nodes[node_idx + 1 + add_idx];
+        if (!add || add->op != GGML_OP_ADD || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return 0;
+        }
+        if (add->type != GGML_TYPE_F32 ||
+            add->ne[0] != 2048 || add->ne[1] != 1 || add->ne[2] != 1 || add->ne[3] != 1 ||
+            add->nb[0] != (int64_t) sizeof(float)) {
+            return 0;
+        }
+
+        const ggml_tensor * view = nullptr;
+        if (add_idx == 0) {
+            if (!ggml_sycl_moe_weighted_sum_view_index(add->src[0], mul, seen) ||
+                !ggml_sycl_moe_weighted_sum_view_index(add->src[1], mul, seen)) {
+                return 0;
+            }
+        } else {
+            if (add->src[0] == prev) {
+                view = add->src[1];
+            } else if (add->src[1] == prev) {
+                view = add->src[0];
+            } else {
+                return 0;
+            }
+            if (!ggml_sycl_moe_weighted_sum_view_index(view, mul, seen)) {
+                return 0;
+            }
+        }
+        prev = add;
+    }
+
+    for (int i = 0; i < 8; ++i) {
+        if (!seen[i]) {
+            return 0;
+        }
+    }
+
+    ggml_tensor * add0 = cgraph->nodes[node_idx + 8];
+    ggml_tensor * add1 = cgraph->nodes[node_idx + 9];
+    if (!add0 || !add1 ||
+        add0->op != GGML_OP_ADD || add1->op != GGML_OP_ADD ||
+        (add0->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+        (add1->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+
+    if (add0->src[0] != prev && add0->src[1] != prev) {
+        return 0;
+    }
+    if (add1->src[0] != add0 && add1->src[1] != add0) {
+        return 0;
+    }
+
+    const ggml_tensor * add0_c = add0->src[0] == prev ? add0->src[1] : add0->src[0];
+    const ggml_tensor * add1_c = add1->src[0] == add0 ? add1->src[1] : add1->src[0];
+    if (!ggml_sycl_is_nx2_f32_vector(add0) || !ggml_sycl_is_nx2_f32_vector(add1) ||
+        !ggml_sycl_is_nx2_f32_vector(add0_c) || !ggml_sycl_is_nx2_f32_vector(add1_c)) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 10, node_idx + 9)) {
+        return 0;
+    }
+
+    return ggml_sycl_moe_weighted_tail_8_f32(weighted, weights, add0_c, add1_c, add1, ctx.stream()) ? 9 : 0;
+}
+
+static bool ggml_sycl_is_nx2_f32_vector(const ggml_tensor * t) {
+    return t && t->type == GGML_TYPE_F32 &&
+        t->ne[0] == 2048 && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+        t->nb[0] == (int64_t) sizeof(float) && ggml_is_contiguous(t);
+}
+
+static bool ggml_sycl_is_f32_scalar(const ggml_tensor * t) {
+    return t && t->type == GGML_TYPE_F32 &&
+        t->ne[0] == 1 && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+        t->nb[0] == (int64_t) sizeof(float);
+}
+
+static bool ggml_sycl_rms_norm_mul_nx2_f32(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * rms, const ggml_tensor * mul, bool write_q8) {
+    const ggml_tensor * x = rms->src[0];
+    const ggml_tensor * w = mul->src[0] == rms ? mul->src[1] : mul->src[0];
+    if (!ggml_sycl_is_nx2_f32_vector(x) ||
+        !ggml_sycl_is_nx2_f32_vector(rms) ||
+        !ggml_sycl_is_nx2_f32_vector(w) ||
+        !ggml_sycl_is_nx2_f32_vector(mul)) {
+        return false;
+    }
+
+    float eps;
+    memcpy(&eps, rms->op_params, sizeof(float));
+
+    const float * x_data = (const float *) x->data;
+    const float * w_data = (const float *) w->data;
+    float * out          = (float *) mul->data;
+
+    constexpr int ncols = 2048;
+    const int wg_size = g_ggml_sycl_enable_rms_norm_mul_fusion >= 2 ? 1024 : 512;
+    const int nwarps  = wg_size / WARP_SIZE;
+    char * q8_out = nullptr;
+    size_t q8_row_stride = 0;
+    if (write_q8) {
+        constexpr int src1_padded_cols = GGML_PAD(ncols, MATRIX_ROW_PADDING);
+        q8_row_stride = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+        if (!ctx.moe_act_q8_alloc) {
+            ctx.moe_act_q8_alloc = std::make_unique<ggml_sycl_pool_alloc<char>>(ctx.pool());
+        }
+        if (!ctx.moe_act_q8 || ctx.moe_act_q8_size < q8_row_stride) {
+            ctx.moe_act_q8 = ctx.moe_act_q8_alloc->realloc(q8_row_stride);
+            ctx.moe_act_q8_size = ctx.moe_act_q8_alloc->actual_size;
+        }
+        q8_out = ctx.moe_act_q8;
+    }
+
+    dpct::queue_ptr stream = ctx.stream();
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> local_sums(sycl::range<1>(nwarps), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(wg_size), sycl::range<1>(wg_size)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int tid = item.get_local_linear_id();
+                const sycl::sub_group sg = item.get_sub_group();
+                const int sg_id = sg.get_group_linear_id();
+                const int lane  = sg.get_local_linear_id();
+                const int sg_size = sg.get_local_range()[0];
+
+                float sumsq = 0.0f;
+                for (int col = tid; col < ncols; col += wg_size) {
+                    const float xi = x_data[col];
+                    sumsq += xi * xi;
+                }
+
+                sumsq = sycl::reduce_over_group(sg, sumsq, sycl::plus<>());
+                if (lane == 0) {
+                    local_sums[sg_id] = sumsq;
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                if (sg_id == 0) {
+                    float total = 0.0f;
+                    for (int idx = lane; idx < nwarps; idx += sg_size) {
+                        total += local_sums[idx];
+                    }
+                    total = sycl::reduce_over_group(sg, total, sycl::plus<>());
+                    if (lane == 0) {
+                        local_sums[0] = sycl::rsqrt(total / ncols + eps);
+                    }
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                const float scale = local_sums[0];
+                if (write_q8) {
+                    const int block = sg_id;
+                    if (block < ncols / QK8_1) {
+                        const int col0 = block * QK8_1 + lane * 2;
+                        const int col1 = col0 + 1;
+                        const float v0 = x_data[col0] * scale * w_data[col0];
+                        const float v1 = x_data[col1] * scale * w_data[col1];
+                        out[col0] = v0;
+                        out[col1] = v1;
+
+                        float sum = v0 + v1;
+                        float amax = sycl::fmax(sycl::fabs(v0), sycl::fabs(v1));
+                        sum = sycl::reduce_over_group(sg, sum, sycl::plus<>());
+                        amax = sycl::reduce_over_group(sg, amax, sycl::maximum<>());
+
+                        const float quant_d = amax == 0.0f ? 1.0f : amax / 127.0f;
+                        int8_t * qs = (int8_t *) q8_out + block * QK8_1 + lane * 2;
+                        qs[0] = (int8_t) sycl::round(v0 / quant_d);
+                        qs[1] = (int8_t) sycl::round(v1 / quant_d);
+
+                        if (lane == 0) {
+                            sycl::half2 * ds = (sycl::half2 *) (q8_out + ncols + block * sizeof(sycl::half2));
+                            *ds = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : quant_d), sycl::half(sum));
+                        }
+                    }
+                } else {
+                    for (int col = tid; col < ncols; col += wg_size) {
+                        out[col] = x_data[col] * scale * w_data[col];
+                    }
+                }
+            });
+    });
+
+    if (write_q8) {
+        ctx.moe_act_q8_src = mul;
+        ctx.moe_act_q8_ne0 = ncols;
+        ctx.moe_act_q8_ne1 = 1;
+        ctx.moe_act_q8_row_stride = q8_row_stride;
+    }
+    return true;
