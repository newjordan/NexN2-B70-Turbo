+        shexp = mul->src[0];
+        gate  = mul->src[1];
+    } else if (ggml_sycl_is_nx2_f32_vector(mul->src[1]) && ggml_sycl_is_f32_scalar(mul->src[0])) {
+        shexp = mul->src[1];
+        gate  = mul->src[0];
+    } else {
+        return 0;
+    }
+
+    const ggml_tensor * moe      = add0->src[0] == mul ? add0->src[1] : add0->src[0];
+    const ggml_tensor * residual = add1->src[0] == add0 ? add1->src[1] : add1->src[0];
+    if (!ggml_sycl_is_nx2_f32_vector(mul) ||
+        !ggml_sycl_is_nx2_f32_vector(add0) ||
+        !ggml_sycl_is_nx2_f32_vector(add1) ||
+        !ggml_sycl_is_nx2_f32_vector(moe) ||
+        !ggml_sycl_is_nx2_f32_vector(residual)) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 3, node_idx + 2)) {
+        return 0;
+    }
+
+    if (g_ggml_sycl_enable_moe_shared_gate_tail_fusion == 6) {
+        return ggml_sycl_moe_shared_gate_tail_f32_vec4_local_gate(shexp, gate, moe, residual, add1, ctx.stream()) ? 2 : 0;
+    }
+    if (g_ggml_sycl_enable_moe_shared_gate_tail_fusion == 5) {
+        return ggml_sycl_moe_shared_gate_tail_f32_local_gate(shexp, gate, moe, residual, add1, ctx.stream()) ? 2 : 0;
+    }
+    if (g_ggml_sycl_enable_moe_shared_gate_tail_fusion == 2) {
+        return ggml_sycl_moe_shared_gate_tail_f32_vec4(shexp, gate, moe, residual, add1, ctx.stream()) ? 2 : 0;
