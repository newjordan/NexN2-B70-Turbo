+static bool ggml_sycl_moe_shared_gate_tail_f32(
+    const ggml_tensor * shexp, const ggml_tensor * gate,
+    const ggml_tensor * moe, const ggml_tensor * residual,
+    ggml_tensor * dst, dpct::queue_ptr stream) {
+    if (dst->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+
+    const float * shexp_data    = (const float *) shexp->data;
+    const float * gate_data     = (const float *) gate->data;
+    const float * moe_data      = (const float *) moe->data;
+    const float * residual_data = (const float *) residual->data;
+    float * out                 = (float *) dst->data;
+
+    stream->parallel_for(sycl::range<1>(2048), [=](sycl::id<1> tid) {
+        const size_t row = tid[0];
+        out[row] = moe_data[row] + shexp_data[row] * gate_data[0] + residual_data[row];
+    });
+    return true;
+}
