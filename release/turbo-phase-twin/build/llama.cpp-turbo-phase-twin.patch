+static int ggml_sycl_try_fuse_moe_shared_gate_tail(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (g_ggml_sycl_enable_moe_shared_gate_tail_fusion <= 0 ||
+        (g_ggml_sycl_enable_moe_shared_gate_tail_fusion > 2 &&
+         g_ggml_sycl_enable_moe_shared_gate_tail_fusion < 5) ||
+        g_ggml_sycl_enable_moe_shared_gate_tail_fusion > 6 ||
+        g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx,
+            { GGML_OP_MUL, GGML_OP_ADD, GGML_OP_ADD }, { node_idx + 2 })) {
+        return 0;
+    }
+
+    ggml_tensor * mul  = cgraph->nodes[node_idx];
+    ggml_tensor * add0 = cgraph->nodes[node_idx + 1];
+    ggml_tensor * add1 = cgraph->nodes[node_idx + 2];
+    if (!mul || !add0 || !add1 ||
+        (add0->src[0] != mul && add0->src[1] != mul) ||
+        (add1->src[0] != add0 && add1->src[1] != add0)) {
+        return 0;
+    }
+
+    const ggml_tensor * shexp = nullptr;
+    const ggml_tensor * gate  = nullptr;
