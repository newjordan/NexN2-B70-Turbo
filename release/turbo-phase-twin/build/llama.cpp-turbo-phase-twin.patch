+        g_ggml_sycl_enable_moe_gate_up_q8_handoff &&
+        use_reorder &&
+        ctx.moe_gate_up_q8_src == src1 &&
+        ctx.moe_gate_up_q8 != nullptr &&
+        ctx.moe_gate_up_q8_row_stride == bytes_per_qrow &&
+        src0->type == GGML_TYPE_Q6_K &&
