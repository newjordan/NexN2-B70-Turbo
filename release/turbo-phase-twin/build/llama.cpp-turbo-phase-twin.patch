+// IQ3_A770: Q3_K-style bit packing (2 low bits in qs, 1 high bit in hmask) with a
+// non-uniform 8-entry LUT (kvalues_iq3nl) and 8 sub-blocks of 32 with 4-bit signed
+// scales. One vec_dot call covers one sub-block of 32: iqs == ib32 in [0,7], aligned
+// with q8_1 block ib32. Reproduces ggml_vec_dot_iq3_a770_q8_K (CPU oracle) bit-for-bit:
+//   code = ((qs[32*(is>>2) + l] >> (2*(is&3))) & 3) | (((hmask[l] >> is) & 1) << 2)
+//   x    = d * sc * kvalues_iq3nl[code],  sc = ((scales[is>>1] >> 4*(is&1)) & 0xF) - 8
+static __dpct_inline__ float
+vec_dot_iq3_a770_q8_1(const void *__restrict__ vbq,
+                      const block_q8_1 *__restrict__ bq8_1, const int &iqs) {
+#if QK_K == 256
+    const block_iq3_a770 * bq = (const block_iq3_a770 *) vbq;
+    const int8_t * kv = kvalues_iq3nl;
+
+    const int is    = iqs;            // sub-block of 32 (0..7)
+    const int shift = 2 * (is & 3);   // 2-bit field within the qs byte (0/2/4/6)
+
+    const uint8_t * qs = bq->qs + 32 * (is >> 2); // first half -> qs[0..31], second -> qs[32..63]
+    const uint8_t * hm = bq->hmask;
+    const int8_t  * q8 = bq8_1[is].qs;
+
+    int sumi = 0;
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {     // 8 groups of 4 -> 8 dp4a over the 32-wide sub-block
+        const int l = 4 * k;
+        const int v =
+            ((kv[((qs[l + 0] >> shift) & 3) | (((hm[l + 0] >> is) & 1) << 2)] & 0xFF) <<  0) |
+            ((kv[((qs[l + 1] >> shift) & 3) | (((hm[l + 1] >> is) & 1) << 2)] & 0xFF) <<  8) |
+            ((kv[((qs[l + 2] >> shift) & 3) | (((hm[l + 2] >> is) & 1) << 2)] & 0xFF) << 16) |
+            ((kv[((qs[l + 3] >> shift) & 3) | (((hm[l + 3] >> is) & 1) << 2)] & 0xFF) << 24);
+        sumi = dpct::dp4a(v, get_int_from_int8(q8, k), sumi);
+    }
+
+    const int   sc = (int)((bq->scales[is >> 1] >> (4 * (is & 1))) & 0xF) - 8;
+    const float d  = (float) bq->d * sc * bq8_1[is].ds[0];
+    return d * sumi;
+#else
+    assert(false);
+    return 0.f;
+#endif
+}
