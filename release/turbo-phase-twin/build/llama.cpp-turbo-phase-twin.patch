+    // iqs == ib32 (sub-block of 32, 0..7), driven by traits::qi == 8. Reads the SoA planes
+    // [qs][hmask][scales][d] and reproduces vec_dot_iq3_a770_q8_1 (the M2 dense dp4a kernel).
+    __dpct_inline__ float operator()(const void * __restrict__ vbq, const std::pair<int, int> ibx_offset,
