+static bool ggml_sycl_moe_shared_gate_tail_f32_local_gate(
+    const ggml_tensor * shexp, const ggml_tensor * gate,
+    const ggml_tensor * moe, const ggml_tensor * residual,
+    ggml_tensor * dst, dpct::queue_ptr stream) {
+    if (dst->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+
+    const float * shexp_data    = (const float *) shexp->data;
+    const float * gate_data     = (const float *) gate->data;
+    const float * moe_data      = (const float *) moe->data;
+    const float * residual_data = (const float *) residual->data;
+    float * out                 = (float *) dst->data;
+
+    constexpr int wg_size = 512;
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> gate_local(sycl::range<1>(1), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(2048), sycl::range<1>(wg_size)),
+            [=](sycl::nd_item<1> item) {
+                if (item.get_local_linear_id() == 0) {
+                    gate_local[0] = gate_data[0];
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                const size_t row = item.get_global_linear_id();
+                out[row] = moe_data[row] + shexp_data[row] * gate_local[0] + residual_data[row];
+            });
+    });
+    return true;
+}
