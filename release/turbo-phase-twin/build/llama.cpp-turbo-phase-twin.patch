+// ====================== IQ3_A770 (A770 3-bit; Q3_K packing, 8x32 4-bit scales, NF3 LUT)
+// 3-bit codes index a non-uniform 8-entry LUT (kvalues_iq3nl) fit to the weight
+// distribution: x = d * sc * kvalues_iq3nl[code]. Same 102 B / 3.1875 bpw block as the
+// uniform version; the LUT is tiny (8 int8 -> registers), so the SYCL dp4a path is intact.
+
+static void quantize_row_iq3_a770_impl(const float * GGML_RESTRICT x, block_iq3_a770 * GGML_RESTRICT y, int64_t n_per_row, const float * GGML_RESTRICT quant_weights) {
+    assert(n_per_row % QK_K == 0);
+    const int nb = n_per_row / QK_K;
+    const int8_t * kv = kvalues_iq3nl;
+    const int kz = best_index_int8(8, kv, 0.0f); // code nearest 0, for empty sub-blocks
+
+    uint8_t L[QK_K];
+    float   scales[QK_K / 32];
+    float   weight[32];
+
+    for (int i = 0; i < nb; i++) {
+
+        float sigma2 = 0;
+        for (int j = 0; j < QK_K; ++j) sigma2 += x[j]*x[j];
+        sigma2 *= 2.f/QK_K;
+
+        float max_scale = 0, amax_scale = 0;
+        for (int ib = 0; ib < QK_K/32; ++ib) {
+            const float * xb = x + 32*ib;
+            uint8_t * Lb = L + 32*ib;
+            if (quant_weights) {
+                const float * qw = quant_weights + QK_K*i + 32*ib;
+                for (int j = 0; j < 32; ++j) weight[j] = qw[j]*sqrtf(sigma2 + xb[j]*xb[j]);
+            } else {
+                for (int j = 0; j < 32; ++j) weight[j] = xb[j]*xb[j];
+            }
+            float amax = 0, max = 0;
+            for (int j = 0; j < 32; ++j) { float ax = fabsf(xb[j]); if (ax > amax) { amax = ax; max = xb[j]; } }
+            if (amax < GROUP_MAX_EPS) { scales[ib] = 0; for (int j = 0; j < 32; ++j) Lb[j] = kz; continue; }
+            // initial scale: map max element onto the extreme LUT level, then refine by least-squares
+            float d = -max/kv[0];
+            float id = 1/d;
+            float sumqx = 0, sumq2 = 0;
+            for (int j = 0; j < 32; ++j) {
+                int l = best_index_int8(8, kv, id*xb[j]);
+                Lb[j] = l;
+                float q = kv[l], w = weight[j];
+                sumqx += w*q*xb[j]; sumq2 += w*q*q;
+            }
+            d = sumq2 > 0 ? sumqx/sumq2 : 0.f;
+            float best = d*sumqx;
+            for (int itry = -3; itry <= 3; ++itry) {
+                id = (itry + kv[0])/max;
+                sumqx = sumq2 = 0;
+                for (int j = 0; j < 32; ++j) {
+                    int l = best_index_int8(8, kv, id*xb[j]);
+                    float q = kv[l], w = weight[j];
+                    sumqx += w*q*xb[j]; sumq2 += w*q*q;
+                }
+                if (sumq2 > 0 && sumqx*sumqx > best*sumq2) { d = sumqx/sumq2; best = d*sumqx; }
+            }
+            scales[ib] = d;
+            float ad = fabsf(d);
+            if (ad > amax_scale) { amax_scale = ad; max_scale = d; }
+        }
+
+        memset(y[i].scales, 0, 4);
+        memset(y[i].hmask, 0, QK_K/8);
+        memset(y[i].qs, 0, QK_K/4);
+
+        if (max_scale) {
+            float iscale = -8.f/max_scale; // 4-bit signed sub-block scales in [-8,7]
+            float d_blk  = 1/iscale;
+            y[i].d = GGML_FP32_TO_FP16(d_blk);
+            for (int ib = 0; ib < QK_K/32; ++ib) {
+                int l = nearest_int(iscale*scales[ib]);
+                l = MAX(-8, MIN(7, l)) + 8; // stored as [0,15]
+                y[i].scales[ib>>1] |= ((l & 0xF) << (4*(ib&1)));
+                int8_t sc = (int8_t)l - 8;
+                float dl = d_blk * sc;
+                if (dl) {
+                    float idl = 1/dl;
+                    for (int j = 0; j < 32; ++j) L[32*ib+j] = best_index_int8(8, kv, idl*x[32*ib+j]);
+                } else {
+                    for (int j = 0; j < 32; ++j) L[32*ib+j] = kz;
+                }
+            }
+        } else {
+            y[i].d = GGML_FP32_TO_FP16(0.f);
+            for (int j = 0; j < QK_K; ++j) L[j] = kz;
+        }
+
+        // pack LUT index L (0..7): low 2 bits -> qs, high bit -> hmask (same layout as before)
+        int m = 0;
+        uint8_t hm = 1;
+        for (int j = 0; j < QK_K; ++j) {
+            if (L[j] > 3) { y[i].hmask[m] |= hm; L[j] -= 4; }
+            if (++m == QK_K/8) { m = 0; hm <<= 1; }
+        }
+        for (int j = 0; j < QK_K; j += 128) {
+            for (int l = 0; l < 32; ++l) {
+                y[i].qs[j/4 + l] = L[j + l] | (L[j + l + 32] << 2) | (L[j + l + 64] << 4) | (L[j + l + 96] << 6);
+            }
+        }
+
+        x += QK_K;
+    }
