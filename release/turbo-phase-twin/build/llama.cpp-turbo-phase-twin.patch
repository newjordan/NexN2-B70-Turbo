+        const ggml_half2 * dms_up   = reinterpret_cast<const ggml_half2 *>(base_up + d_offset.second);
+        const ggml_half2 * dms_gate = reinterpret_cast<const ggml_half2 *>(base_gate + d_offset.second);
+
+        const int bq8_offset = QR5_K * ((iqs / 2) / (QI8_1 / 2));
+        const int * ql_up    = (const int *) (qs_up   + 16 * bq8_offset + 4 * ((iqs / 2) % 4));
+        const int * ql_gate  = (const int *) (qs_gate + 16 * bq8_offset + 4 * ((iqs / 2) % 4));
+        const int * qh_up_ptr   = (const int *) (qh_up   + 4 * ((iqs / 2) % 4));
+        const int * qh_gate_ptr = (const int *) (qh_gate + 4 * ((iqs / 2) % 4));
+        const uint16_t * scales_up   = (const uint16_t *) scs_up;
+        const uint16_t * scales_gate = (const uint16_t *) scs_gate;
+
+        const int vl_up0   = ql_up[0];
+        const int vl_up1   = ql_up[4];
+        const int vl_gate0 = ql_gate[0];
+        const int vl_gate1 = ql_gate[4];
+        const int vh_up0   = qh_up_ptr[0] >> bq8_offset;
+        const int vh_up1   = qh_up_ptr[4] >> bq8_offset;
+        const int vh_gate0 = qh_gate_ptr[0] >> bq8_offset;
+        const int vh_gate1 = qh_gate_ptr[4] >> bq8_offset;
+
+        uint16_t aux_up[2];
+        uint16_t aux_gate[2];
+        const int j = (QR5_K * ((iqs / 2) / (QI8_1 / 2))) / 2;
+        if (j < 2) {
+            aux_up[0]   = scales_up[j + 0] & 0x3f3f;
+            aux_up[1]   = scales_up[j + 2] & 0x3f3f;
+            aux_gate[0] = scales_gate[j + 0] & 0x3f3f;
+            aux_gate[1] = scales_gate[j + 2] & 0x3f3f;
+        } else {
+            aux_up[0]   = ((scales_up[j + 2] >> 0) & 0x0f0f) | ((scales_up[j - 2] & 0xc0c0) >> 2);
+            aux_up[1]   = ((scales_up[j + 2] >> 4) & 0x0f0f) | ((scales_up[j - 0] & 0xc0c0) >> 2);
+            aux_gate[0] = ((scales_gate[j + 2] >> 0) & 0x0f0f) | ((scales_gate[j - 2] & 0xc0c0) >> 2);
+            aux_gate[1] = ((scales_gate[j + 2] >> 4) & 0x0f0f) | ((scales_gate[j - 0] & 0xc0c0) >> 2);
+        }
+
+        const uint8_t * sc_up   = (const uint8_t *) aux_up;
+        const uint8_t * m_up    = sc_up + 2;
+        const uint8_t * sc_gate = (const uint8_t *) aux_gate;
+        const uint8_t * m_gate  = sc_gate + 2;
+
+        float sumf_d_up   = 0.0f;
+        float sumf_m_up   = 0.0f;
+        float sumf_d_gate = 0.0f;
+        float sumf_m_gate = 0.0f;
+
+#pragma unroll
+        for (int i = 0; i < QR5_K; ++i) {
+            const int8_t * quant_base_ptr = q8_1_quant_ptr + (bq8_offset + i) * QK8_1;
+            const sycl::half2 ds_values = *(q8_1_ds + bq8_offset + i);
+            const float d8 = ds_values[0];
+            const int * q8 = (const int *) quant_base_ptr + ((iqs / 2) % 4);
+            const int u0 = q8[0];
+            const int u1 = q8[4];
+            const int dot2 = dpct::dp4a(0x01010101, u0, dpct::dp4a(0x01010101, u1, 0));
+
+            const int vl0_up = (vl_up0 >> (4 * i)) & 0x0F0F0F0F;
+            const int vl1_up = (vl_up1 >> (4 * i)) & 0x0F0F0F0F;
+            const int vh0_up = ((vh_up0 >> i) << 4) & 0x10101010;
+            const int vh1_up = ((vh_up1 >> i) << 4) & 0x10101010;
+            const int v0_up = vl0_up | vh0_up;
+            const int v1_up = vl1_up | vh1_up;
+            const int dot1_up = dpct::dp4a(v0_up, u0, dpct::dp4a(v1_up, u1, 0));
+            sumf_d_up += d8 * (dot1_up * sc_up[i]);
+            sumf_m_up += d8 * (dot2 * m_up[i]);
+
+            const int vl0_gate = (vl_gate0 >> (4 * i)) & 0x0F0F0F0F;
+            const int vl1_gate = (vl_gate1 >> (4 * i)) & 0x0F0F0F0F;
+            const int vh0_gate = ((vh_gate0 >> i) << 4) & 0x10101010;
+            const int vh1_gate = ((vh_gate1 >> i) << 4) & 0x10101010;
+            const int v0_gate = vl0_gate | vh0_gate;
+            const int v1_gate = vl1_gate | vh1_gate;
+            const int dot1_gate = dpct::dp4a(v0_gate, u0, dpct::dp4a(v1_gate, u1, 0));
+            sumf_d_gate += d8 * (dot1_gate * sc_gate[i]);
+            sumf_m_gate += d8 * (dot2 * m_gate[i]);
+        }
+
+        const sycl::float2 dm_up_f = dms_up->convert<float, sycl::rounding_mode::automatic>();
+        const sycl::float2 dm_gate_f = dms_gate->convert<float, sycl::rounding_mode::automatic>();
+        partial_up   += dm_up_f.x()   * sumf_d_up   - dm_up_f.y()   * sumf_m_up;
+        partial_gate += dm_gate_f.x() * sumf_d_gate - dm_gate_f.y() * sumf_m_gate;
+    }
+};
