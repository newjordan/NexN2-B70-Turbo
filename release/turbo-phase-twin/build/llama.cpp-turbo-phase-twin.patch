+static void launch_mul_mat_vec_q_moe_swiglu_reorder_nx2_local_q8(
+    const void * vup_base, const void * vgate_base, const void * vy,
+    const int32_t * ids_dev, float * dst_base, const int n_experts_used,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_row_stride, dpct::queue_ptr stream) {
+    constexpr int ncols = 2048;
+    constexpr int nrows = 512;
+    constexpr int q8_blocks = ncols / QK8_1;
+
+    const int            block_num_y = (nrows + rows_per_workgroup - 1) / rows_per_workgroup;
+    const sycl::range<3> block_nums(1, (unsigned) n_experts_used, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, rows_per_workgroup, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<int8_t, 1> local_qs(sycl::range<1>(ncols), cgh);
+        sycl::local_accessor<sycl::half2, 1> local_ds(sycl::range<1>(q8_blocks), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_swiglu_reorder_nx2_local_q8<reorder_vec_dot_q_sycl, ncols, nrows, rows_per_workgroup>(
+                    vup_base, vgate_base, vy, dst_base, ids_dev,
+                    expert_weight_stride, dst_row_stride, src1_row_stride,
+                    local_qs, local_ds, item);
+            });
+    });
+}
