+static int ggml_sycl_try_fuse_moe_weighted_sum(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_weighted_sum_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (node_idx + 7 >= cgraph->n_nodes) {
+        return 0;
+    }
+
+    ggml_tensor * mul = cgraph->nodes[node_idx];
+    if (!mul || mul->op != GGML_OP_MUL || (mul->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    if (mul->type != GGML_TYPE_F32 ||
+        mul->ne[0] != 2048 || mul->ne[1] != 8 || mul->ne[2] != 1 || mul->ne[3] != 1 ||
+        mul->nb[0] != (int64_t) sizeof(float) || mul->nb[1] != 2048 * (int64_t) sizeof(float)) {
+        return 0;
+    }
+
+    const ggml_tensor * weighted = nullptr;
+    const ggml_tensor * weights  = nullptr;
+    for (int src_idx = 0; src_idx < 2; ++src_idx) {
+        const ggml_tensor * src = mul->src[src_idx];
+        if (!src || src->type != GGML_TYPE_F32) {
+            return 0;
+        }
+        if (src->op == GGML_OP_MUL_MAT_ID &&
+            src->ne[0] == 2048 && src->ne[1] == 8 && src->ne[2] == 1 && src->ne[3] == 1 &&
+            src->nb[0] == (int64_t) sizeof(float) && src->nb[1] == 2048 * (int64_t) sizeof(float)) {
+            weighted = src;
+        } else if (src->ne[0] == 1 && src->ne[1] == 8 && src->ne[2] == 1 && src->ne[3] == 1 &&
+            src->nb[0] == (int64_t) sizeof(float)) {
+            weights = src;
+        }
+    }
+    if (!weighted || !weights) {
+        return 0;
+    }
+
+    bool seen[8] = {};
+    ggml_tensor * prev = nullptr;
+    for (int add_idx = 0; add_idx < 7; ++add_idx) {
+        ggml_tensor * add = cgraph->nodes[node_idx + 1 + add_idx];
+        if (!add || add->op != GGML_OP_ADD || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return 0;
+        }
+        if (add->type != GGML_TYPE_F32 ||
+            add->ne[0] != 2048 || add->ne[1] != 1 || add->ne[2] != 1 || add->ne[3] != 1 ||
+            add->nb[0] != (int64_t) sizeof(float)) {
+            return 0;
+        }
+
+        const ggml_tensor * view = nullptr;
+        if (add_idx == 0) {
+            if (!ggml_sycl_moe_weighted_sum_view_index(add->src[0], mul, seen) ||
+                !ggml_sycl_moe_weighted_sum_view_index(add->src[1], mul, seen)) {
+                return 0;
+            }
+        } else {
+            if (add->src[0] == prev) {
+                view = add->src[1];
+            } else if (add->src[1] == prev) {
+                view = add->src[0];
+            } else {
+                return 0;
+            }
+            if (!ggml_sycl_moe_weighted_sum_view_index(view, mul, seen)) {
+                return 0;
+            }
+        }
+        prev = add;
+    }
+
+    for (int i = 0; i < 8; ++i) {
+        if (!seen[i]) {
+            return 0;
+        }
+    }
+
+    ggml_tensor * dst = cgraph->nodes[node_idx + 7];
+    if (!dst || !ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 8, node_idx + 7)) {
+        return 0;
+    }
+
+    if (g_ggml_sycl_enable_moe_weighted_sum_fusion == 2) {
+        return ggml_sycl_moe_weighted_sum_8_f32_vec4(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+    }
+    if (g_ggml_sycl_enable_moe_weighted_sum_fusion == 3) {
+        return ggml_sycl_moe_weighted_sum_8_f32_local_weights(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+    }
+
+    return ggml_sycl_moe_weighted_sum_8_f32(weighted, weights, dst, ctx.stream()) ? 7 : 0;
+}
