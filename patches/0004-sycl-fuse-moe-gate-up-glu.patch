+bool ggml_sycl_mul_mat_vec_q_id_swiglu_reorder_nx2_q8_handoff(
+    enum ggml_type     src0_type,
+    const void *       vup_base,
+    const void *       vgate_base,
+    const void *       vy,
+    const int32_t *    ids_dev,
+    float *            dst_base,
+    void *             q8_dst_base,
+    int                n_experts_used,
+    size_t             expert_weight_stride,
+    size_t             dst_row_stride,
+    size_t             src1_row_stride,
+    size_t             q8_row_stride,
+    dpct::queue_ptr    stream) {
+    switch (src0_type) {
+        case GGML_TYPE_Q4_K:
+            launch_mul_mat_vec_q_moe_swiglu_reorder_nx2_q8_handoff<reorder_vec_dot_q_sycl<GGML_TYPE_Q4_K>>(
+                vup_base, vgate_base, vy, ids_dev, dst_base, q8_dst_base,
+                n_experts_used, expert_weight_stride, dst_row_stride,
+                src1_row_stride, q8_row_stride, stream);
+            return true;
+        case GGML_TYPE_Q5_K:
+            launch_mul_mat_vec_q_moe_swiglu_reorder_nx2_q8_handoff<reorder_vec_dot_q_sycl<GGML_TYPE_Q5_K>>(
+                vup_base, vgate_base, vy, ids_dev, dst_base, q8_dst_base,
+                n_experts_used, expert_weight_stride, dst_row_stride,
+                src1_row_stride, q8_row_stride, stream);
             return true;
         default:
             return false;
