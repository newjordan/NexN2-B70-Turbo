+    constexpr int block_elements_per_subgroup = block_traits::qi / block_traits::vdr_mmvq;
+
+    static_assert(ncols_t == 2048);
+    static_assert(nrows_t == 512);
+    static_assert(blocks_per_row == 8);
+    static_assert(blocks_per_subgroup == 1);
+    static_assert(block_elements_per_subgroup == WARP_SIZE);
+    static_assert(rows_per_q8_block == 32);
+
+    const int expert_idx = item_ct1.get_group(1);
+    const int i02        = ids_dev[expert_idx];
+    const int local_row  = item_ct1.get_local_id(1);
+    const int row        = item_ct1.get_group(2) * rows_per_q8_block + local_row;
+
+    const char * vup   = (const char *) vup_base   + (size_t) i02 * expert_weight_stride;
+    const char * vgate = (const char *) vgate_base + (size_t) i02 * expert_weight_stride;
+    const char * vy    = (const char *) vy_base    + (size_t) expert_idx * src1_row_stride;
+    float *      dst   = (float *) ((char *) dst_base + (size_t) expert_idx * dst_row_stride);
+
+    const auto sg  = item_ct1.get_sub_group();
+    const int  iqs = block_traits::vdr_mmvq * sg.get_local_linear_id();
+
+    float partial_up   = 0.0f;
+    float partial_gate = 0.0f;
+#pragma unroll
+    for (int i = 0; i < blocks_per_row; ++i) {
+        const int ibx = row * blocks_per_row + i;
+
+        const auto bx_offset = block_type::get_block_offset(ibx, nblocks);
+        const auto d_offset  = block_type::get_d_offset(nrows_t, ncols_t, ibx);
+
+        const int           iby            = i * block_type::block_to_q8_1_ratio();
+        const int8_t *      q8_1_quant_ptr = (const int8_t *) vy + iby * QK8_1;
+        const sycl::half2 * q8_1_ds_ptr    = (const sycl::half2 *) ((const char *) vy + ncols_t + iby * sizeof(sycl::half2));
+
+        partial_up   += reorder_vec_dot_q_sycl()(vup,   bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+        partial_gate += reorder_vec_dot_q_sycl()(vgate, bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+    }
+
+    const float up   = sycl::reduce_over_group(sg, partial_up,   std::plus<>());
+    const float gate = sycl::reduce_over_group(sg, partial_gate, std::plus<>());
+    if (sg.leader()) {
+        const float val = up * (gate / (1.0f + sycl::native::exp(-gate)));
+        dst[row] = val;
+        swiglu_vals[local_row] = val;
+    }
+
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    if (local_row == 0) {
+        const int lane = sg.get_local_linear_id();
+        const float v0 = swiglu_vals[lane];
+        const float v1 = swiglu_vals[lane + WARP_SIZE];
+
+        float sum  = v0 + v1;
+        float amax = sycl::fmax(sycl::fabs(v0), sycl::fabs(v1));
+        sum  = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+        amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+
+        const float d_compute = amax == 0.0f ? 1.0f : amax / 127.0f;
+        const int8_t q0 = sycl::round(v0 / d_compute);
+        const int8_t q1 = sycl::round(v1 / d_compute);
+
+        char * q8_row = (char *) q8_dst_base + (size_t) expert_idx * q8_row_stride;
+        const int q8_col = row / QK8_1;
+        int8_t * qs = (int8_t *) q8_row + q8_col * QK8_1;
+        qs[lane] = q0;
+        qs[lane + WARP_SIZE] = q1;
+
+        if (sg.leader()) {
+            sycl::half2 * ds = (sycl::half2 *) (q8_row + nrows_t + q8_col * sizeof(sycl::half2));
+            const float d_store = amax == 0.0f ? 0.0f : d_compute;
+            *ds = sycl::half2(sycl::half(d_store), sycl::half(sum));
+        }
+    }
+}
+
+template <typename reorder_vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_moe_swiglu_reorder_nx2_q8_handoff(
+    const void * vup_base, const void * vgate_base, const void * vy,
+    const int32_t * ids_dev, float * dst_base, void * q8_dst_base,
+    const int n_experts_used, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t src1_row_stride,
+    const size_t q8_row_stride, dpct::queue_ptr stream) {
+    constexpr int ncols = 2048;
+    constexpr int nrows = 512;
+    constexpr int rows_per_q8_block = QK8_1;
+
+    const int            block_num_y = nrows / rows_per_q8_block;
+    const sycl::range<3> block_nums(1, (unsigned) n_experts_used, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, rows_per_q8_block, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> swiglu_vals(sycl::range<1>(rows_per_q8_block), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_swiglu_reorder_nx2_q8_handoff<reorder_vec_dot_q_sycl, ncols, nrows>(
+                    vup_base, vgate_base, vy, dst_base, q8_dst_base, ids_dev,
+                    expert_weight_stride, dst_row_stride, src1_row_stride,
+                    q8_row_stride, swiglu_vals, item);
+            });
+    });
+}
