+        const int v_up1   = q4_up[4];
+        const int v_gate0 = q4_gate[0];
+        const int v_gate1 = q4_gate[4];
+
+        uint16_t aux_up[2];
+        uint16_t aux_gate[2];
+        const int j = (QR4_K * ((iqs / 2) / (QI8_1 / 2))) / 2;
+        if (j < 2) {
+            aux_up[0]   = scales_up[j + 0] & 0x3f3f;
+            aux_up[1]   = scales_up[j + 2] & 0x3f3f;
+            aux_gate[0] = scales_gate[j + 0] & 0x3f3f;
+            aux_gate[1] = scales_gate[j + 2] & 0x3f3f;
