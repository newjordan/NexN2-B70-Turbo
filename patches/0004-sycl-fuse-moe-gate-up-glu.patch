+    const float * moe_data      = (const float *) moe->data;
+    const float * residual_data = (const float *) residual->data;
+    float * out                 = (float *) dst->data;
+
+    stream->parallel_for(sycl::range<1>(512), [=](sycl::id<1> tid) {
+        const size_t row = tid[0] * 4;
+        const sycl::float4 shexp_v    = *(const sycl::float4 *) (shexp_data + row);
+        const sycl::float4 moe_v      = *(const sycl::float4 *) (moe_data + row);
+        const sycl::float4 residual_v = *(const sycl::float4 *) (residual_data + row);
