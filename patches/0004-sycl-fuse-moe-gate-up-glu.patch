+static bool ggml_sycl_rms_norm_mul_nx2_f32(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * rms, const ggml_tensor * mul, bool write_q8) {
+    const ggml_tensor * x = rms->src[0];
+    const ggml_tensor * w = mul->src[0] == rms ? mul->src[1] : mul->src[0];
+    if (!ggml_sycl_is_nx2_f32_vector(x) ||
+        !ggml_sycl_is_nx2_f32_vector(rms) ||
+        !ggml_sycl_is_nx2_f32_vector(w) ||
+        !ggml_sycl_is_nx2_f32_vector(mul)) {
+        return false;
+    }
+
+    float eps;
+    memcpy(&eps, rms->op_params, sizeof(float));
+
+    const float * x_data = (const float *) x->data;
+    const float * w_data = (const float *) w->data;
+    float * out          = (float *) mul->data;
+
+    constexpr int ncols = 2048;
+    const int wg_size = g_ggml_sycl_enable_rms_norm_mul_fusion >= 2 ? 1024 : 512;
+    const int nwarps  = wg_size / WARP_SIZE;
+    char * q8_out = nullptr;
+    size_t q8_row_stride = 0;
+    if (write_q8) {
+        constexpr int src1_padded_cols = GGML_PAD(ncols, MATRIX_ROW_PADDING);
+        q8_row_stride = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+        if (!ctx.moe_act_q8_alloc) {
+            ctx.moe_act_q8_alloc = std::make_unique<ggml_sycl_pool_alloc<char>>(ctx.pool());
+        }
+        if (!ctx.moe_act_q8 || ctx.moe_act_q8_size < q8_row_stride) {
+            ctx.moe_act_q8 = ctx.moe_act_q8_alloc->realloc(q8_row_stride);
+            ctx.moe_act_q8_size = ctx.moe_act_q8_alloc->actual_size;
+        }
+        q8_out = ctx.moe_act_q8;
+    }
+
+    dpct::queue_ptr stream = ctx.stream();
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> local_sums(sycl::range<1>(nwarps), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(wg_size), sycl::range<1>(wg_size)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int tid = item.get_local_linear_id();
+                const sycl::sub_group sg = item.get_sub_group();
+                const int sg_id = sg.get_group_linear_id();
+                const int lane  = sg.get_local_linear_id();
+                const int sg_size = sg.get_local_range()[0];
+
+                float sumsq = 0.0f;
+                for (int col = tid; col < ncols; col += wg_size) {
+                    const float xi = x_data[col];
+                    sumsq += xi * xi;
+                }
+
+                sumsq = sycl::reduce_over_group(sg, sumsq, sycl::plus<>());
+                if (lane == 0) {
+                    local_sums[sg_id] = sumsq;
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                if (sg_id == 0) {
+                    float total = 0.0f;
+                    for (int idx = lane; idx < nwarps; idx += sg_size) {
+                        total += local_sums[idx];
+                    }
+                    total = sycl::reduce_over_group(sg, total, sycl::plus<>());
+                    if (lane == 0) {
+                        local_sums[0] = sycl::rsqrt(total / ncols + eps);
+                    }
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                const float scale = local_sums[0];
+                if (write_q8) {
+                    const int block = sg_id;
+                    if (block < ncols / QK8_1) {
+                        const int col0 = block * QK8_1 + lane * 2;
+                        const int col1 = col0 + 1;
+                        const float v0 = x_data[col0] * scale * w_data[col0];
+                        const float v1 = x_data[col1] * scale * w_data[col1];
+                        out[col0] = v0;
+                        out[col1] = v1;
+
+                        float sum = v0 + v1;
+                        float amax = sycl::fmax(sycl::fabs(v0), sycl::fabs(v1));
+                        sum = sycl::reduce_over_group(sg, sum, sycl::plus<>());
+                        amax = sycl::reduce_over_group(sg, amax, sycl::maximum<>());
+
+                        const float quant_d = amax == 0.0f ? 1.0f : amax / 127.0f;
+                        int8_t * qs = (int8_t *) q8_out + block * QK8_1 + lane * 2;
+                        qs[0] = (int8_t) sycl::round(v0 / quant_d);
+                        qs[1] = (int8_t) sycl::round(v1 / quant_d);
+
+                        if (lane == 0) {
+                            sycl::half2 * ds = (sycl::half2 *) (q8_out + ncols + block * sizeof(sycl::half2));
+                            *ds = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : quant_d), sycl::half(sum));
+                        }
+                    }
+                } else {
+                    for (int col = tid; col < ncols; col += wg_size) {
+                        out[col] = x_data[col] * scale * w_data[col];
+                    }
+                }
+            });
+    });
+
+    if (write_q8) {
+        ctx.moe_act_q8_src = mul;
+        ctx.moe_act_q8_ne0 = ncols;
+        ctx.moe_act_q8_ne1 = 1;
+        ctx.moe_act_q8_row_stride = q8_row_stride;
+    }
+    return true;
+}
