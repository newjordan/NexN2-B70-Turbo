+static int ggml_sycl_try_fuse_rms_norm_mul(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_rms_norm_mul_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx,
+            { GGML_OP_RMS_NORM, GGML_OP_MUL }, { node_idx + 1 })) {
+        return 0;
+    }
+
+    ggml_tensor * rms = cgraph->nodes[node_idx];
+    ggml_tensor * mul = cgraph->nodes[node_idx + 1];
+    if (!rms || !mul || rms->op != GGML_OP_RMS_NORM || mul->op != GGML_OP_MUL ||
+        (mul->src[0] != rms && mul->src[1] != rms)) {
+        return 0;
+    }
+    if (mul->src[1] == rms && !ggml_are_same_shape(mul->src[0], rms)) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 2, node_idx + 1)) {
+        return 0;
+    }
+
+    const bool write_q8 =
+        g_ggml_sycl_enable_rms_norm_mul_fusion == 3 ||
+        (g_ggml_sycl_enable_rms_norm_mul_fusion == 4 &&
+         ggml_sycl_future_moe_gate_up_uses_src(cgraph, node_idx, mul));
+    return ggml_sycl_rms_norm_mul_nx2_f32(ctx, rms, mul, write_q8) ? 1 : 0;
+}
