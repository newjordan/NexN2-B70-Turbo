+        const int bq8_offset = QR4_K * ((iqs / 2) / (QI8_1 / 2));
+        const int * q4_up    = (const int *) (qs_up   + 16 * bq8_offset + 4 * ((iqs / 2) % 4));
+        const int * q4_gate  = (const int *) (qs_gate + 16 * bq8_offset + 4 * ((iqs / 2) % 4));
