+template <typename reorder_vec_dot_q_sycl, int ncols_t, int nrows_t, bool use_local_q8>
+static void mul_mat_vec_q_moe_swiglu_reorder_nx2_expert_pack(
+    const void * __restrict__ vup_base, const void * __restrict__ vgate_base,
+    const void * __restrict__ vy_base, float * __restrict__ dst_base,
+    const int32_t * __restrict__ ids_dev,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_row_stride,
+    sycl::local_accessor<int8_t, 1> local_qs,
+    sycl::local_accessor<sycl::half2, 1> local_ds,
+    const sycl::nd_item<3> & item_ct1) {
+    using block_type   = ggml_sycl_reordered::block_q_t<reorder_vec_dot_q_sycl::gtype>;
+    using block_traits = typename block_type::traits;
+
+    constexpr int n_experts_used             = 8;
+    constexpr int blocks_per_row              = ncols_t / block_traits::qk;
+    constexpr int nblocks                     = nrows_t * blocks_per_row;
+    constexpr int q8_blocks                   = ncols_t / QK8_1;
+    constexpr int blocks_per_subgroup         = ceil_div(block_traits::vdr_mmvq * WARP_SIZE, block_traits::qi);
+    constexpr int block_elements_per_subgroup = block_traits::qi / block_traits::vdr_mmvq;
+
+    static_assert(ncols_t == 2048);
+    static_assert(nrows_t == 512);
+    static_assert(blocks_per_row == 8);
+    static_assert(blocks_per_subgroup == 1);
+    static_assert(block_elements_per_subgroup == WARP_SIZE);
+
+    const int row        = item_ct1.get_group(2);
+    const int expert_idx = item_ct1.get_local_id(1);
+    const int i02        = ids_dev[expert_idx];
+
+    const char * vup   = (const char *) vup_base   + (size_t) i02 * expert_weight_stride;
+    const char * vgate = (const char *) vgate_base + (size_t) i02 * expert_weight_stride;
+    const char * vy    = (const char *) vy_base    + (size_t) expert_idx * src1_row_stride;
+    float *      dst   = (float *) ((char *) dst_base + (size_t) expert_idx * dst_row_stride);
+
+    if constexpr (use_local_q8) {
+        const int local_linear = expert_idx * WARP_SIZE + item_ct1.get_local_id(2);
+        constexpr int local_size = n_experts_used * WARP_SIZE;
+        for (int idx = local_linear; idx < ncols_t; idx += local_size) {
+            local_qs[idx] = ((const int8_t *) vy)[idx];
+        }
+        for (int idx = local_linear; idx < q8_blocks; idx += local_size) {
+            local_ds[idx] = ((const sycl::half2 *) ((const char *) vy + ncols_t))[idx];
+        }
+        item_ct1.barrier(sycl::access::fence_space::local_space);
+    }
+
+    const auto sg  = item_ct1.get_sub_group();
+    const int  iqs = block_traits::vdr_mmvq * sg.get_local_linear_id();
+
+    float partial_up   = 0.0f;
+    float partial_gate = 0.0f;
+#pragma unroll
+    for (int i = 0; i < blocks_per_row; ++i) {
+        const int ibx = row * blocks_per_row + i;
+
+        const auto bx_offset = block_type::get_block_offset(ibx, nblocks);
+        const auto d_offset  = block_type::get_d_offset(nrows_t, ncols_t, ibx);
+
+        const int iby = i * block_type::block_to_q8_1_ratio();
+        const int8_t * q8_1_quant_ptr = nullptr;
+        const sycl::half2 * q8_1_ds_ptr = nullptr;
+        if constexpr (use_local_q8) {
+            q8_1_quant_ptr = &local_qs[iby * QK8_1];
+            q8_1_ds_ptr    = &local_ds[iby];
+        } else {
+            q8_1_quant_ptr = (const int8_t *) vy + iby * QK8_1;
+            q8_1_ds_ptr    = (const sycl::half2 *) ((const char *) vy + ncols_t + iby * sizeof(sycl::half2));
+        }
+
+        partial_up   += reorder_vec_dot_q_sycl()(vup,   bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+        partial_gate += reorder_vec_dot_q_sycl()(vgate, bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+    }
+
+    const float up   = sycl::reduce_over_group(sg, partial_up,   std::plus<>());
+    const float gate = sycl::reduce_over_group(sg, partial_gate, std::plus<>());
+    if (sg.leader()) {
+        dst[row] = up * (gate / (1.0f + sycl::native::exp(-gate)));
+    }
+}
