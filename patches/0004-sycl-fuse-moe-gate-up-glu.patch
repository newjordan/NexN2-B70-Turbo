+    if (add0->src[0]->nb[0] != (int64_t) sizeof(float) ||
+        add0->src[1]->nb[0] != (int64_t) sizeof(float) ||
+        dst->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+
+    const ggml_tensor * add0_a = add0->src[0];
+    const ggml_tensor * add0_b = add0->src[1];
+    const ggml_tensor * add1_c = add1->src[0] == add0 ? add1->src[1] : add1->src[0];
+
+    if (add1_c->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+
+    const float * a = (const float *) add0_a->data;
+    const float * b = (const float *) add0_b->data;
+    const float * c = (const float *) add1_c->data;
+    float * out     = (float *) dst->data;
+
+    stream->parallel_for(sycl::range<1>(512), [=](sycl::id<1> tid) {
+        const size_t row = tid[0] * 4;
+        const sycl::float4 va = *(const sycl::float4 *) (a + row);
+        const sycl::float4 vb = *(const sycl::float4 *) (b + row);
+        const sycl::float4 vc = *(const sycl::float4 *) (c + row);
+        *(sycl::float4 *) (out + row) = va + vb + vc;
+    });
+    return true;
+}
+
+static bool ggml_sycl_moe_tail_add_rms_norm_2_f32(
+    const ggml_tensor * add0, const ggml_tensor * add1, ggml_tensor * rms,
+    dpct::queue_ptr stream) {
+    if (add1->data == rms->data) {
+        return false;
+    }
+
+    const ggml_tensor * add0_a = add0->src[0];
+    const ggml_tensor * add0_b = add0->src[1];
+    const ggml_tensor * add1_c = add1->src[0] == add0 ? add1->src[1] : add1->src[0];
+
+    const float * a       = (const float *) add0_a->data;
+    const float * b       = (const float *) add0_b->data;
+    const float * c       = (const float *) add1_c->data;
+    float * residual_out  = (float *) add1->data;
+    float * rms_out       = (float *) rms->data;
+
+    float eps;
+    memcpy(&eps, rms->op_params, sizeof(float));
+    const bool add0_is_src0 = add1->src[0] == add0;
+
+    constexpr int ncols   = 2048;
+    constexpr int wg_size = 512;
+    constexpr int nwarps  = wg_size / WARP_SIZE;
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> local_sums(sycl::range<1>(nwarps), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(wg_size), sycl::range<1>(wg_size)),
+            [=](sycl::nd_item<1> item) {
+                const int tid = item.get_local_linear_id();
+                const sycl::sub_group sg = item.get_sub_group();
+                const int sg_id = sg.get_group_linear_id();
+                const int lane  = sg.get_local_linear_id();
+                const int sg_size = sg.get_local_range()[0];
+
+                float sumsq = 0.0f;
+                for (int col = tid; col < ncols; col += wg_size) {
+                    const float ab = a[col] + b[col];
+                    const float x = add0_is_src0 ? (ab + c[col]) : (c[col] + ab);
+                    residual_out[col] = x;
+                    sumsq += x * x;
+                }
+
+                sumsq = sycl::reduce_over_group(sg, sumsq, sycl::plus<>());
+                if (lane == 0) {
+                    local_sums[sg_id] = sumsq;
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                if (sg_id == 0) {
+                    float total = 0.0f;
+                    for (int idx = lane; idx < nwarps; idx += sg_size) {
+                        total += local_sums[idx];
+                    }
+                    total = sycl::reduce_over_group(sg, total, sycl::plus<>());
+                    if (lane == 0) {
+                        local_sums[0] = sycl::rsqrt(total / ncols + eps);
+                    }
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                const float scale = local_sums[0];
+                for (int col = tid; col < ncols; col += wg_size) {
+                    rms_out[col] = residual_out[col] * scale;
+                }
+            });
+    });
+    return true;
+}
+
+static int ggml_sycl_try_fuse_moe_tail_add_rms_norm(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_tail_rms_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx,
+            { GGML_OP_ADD, GGML_OP_ADD, GGML_OP_RMS_NORM }, { node_idx + 1, node_idx + 2 })) {
+        return 0;
+    }
+
+    ggml_tensor * add0 = cgraph->nodes[node_idx];
+    ggml_tensor * add1 = cgraph->nodes[node_idx + 1];
+    ggml_tensor * rms  = cgraph->nodes[node_idx + 2];
+    if (!add0 || !add1 || !rms ||
+        add1->op != GGML_OP_ADD || rms->op != GGML_OP_RMS_NORM ||
+        (add1->src[0] != add0 && add1->src[1] != add0) ||
+        rms->src[0] != add1) {
+        return 0;
+    }
+
+    const ggml_tensor * add1_c = add1->src[0] == add0 ? add1->src[1] : add1->src[0];
+    if (!ggml_sycl_is_nx2_f32_vector(add0) || !ggml_sycl_is_nx2_f32_vector(add1) ||
+        !ggml_sycl_is_nx2_f32_vector(rms) ||
+        !ggml_sycl_is_nx2_f32_vector(add0->src[0]) || !ggml_sycl_is_nx2_f32_vector(add0->src[1]) ||
+        !ggml_sycl_is_nx2_f32_vector(add1_c)) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 3, node_idx + 1) ||
+        !ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 3, node_idx + 2)) {
+        return 0;
+    }
+
+    return ggml_sycl_moe_tail_add_rms_norm_2_f32(add0, add1, rms, ctx.stream()) ? 2 : 0;
+}
+
+static int ggml_sycl_try_fuse_moe_tail_add(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_tail_add_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx,
+            { GGML_OP_ADD, GGML_OP_ADD }, { node_idx + 1 })) {
+        return 0;
+    }
+
+    ggml_tensor * add0 = cgraph->nodes[node_idx];
+    ggml_tensor * add1 = cgraph->nodes[node_idx + 1];
+    if (add1->src[0] != add0 && add1->src[1] != add0) {
+        return 0;
+    }
+
+    const ggml_tensor * add1_c = add1->src[0] == add0 ? add1->src[1] : add1->src[0];
+    if (!ggml_sycl_is_nx2_f32_vector(add0) || !ggml_sycl_is_nx2_f32_vector(add1) ||
+        !ggml_sycl_is_nx2_f32_vector(add0->src[0]) || !ggml_sycl_is_nx2_f32_vector(add0->src[1]) ||
+        !ggml_sycl_is_nx2_f32_vector(add1_c)) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 2, node_idx + 1)) {
+        return 0;
+    }
+
+    if (g_ggml_sycl_enable_moe_tail_add_fusion == 2) {
+        return ggml_sycl_moe_tail_add_2_f32_vec4(add0, add1, add1, ctx.stream()) ? 1 : 0;
+    }
+
+    return ggml_sycl_moe_tail_add_2_f32(add0, add1, add1, ctx.stream()) ? 1 : 0;
 }

