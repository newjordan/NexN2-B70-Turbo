+        partial_up   += dm_up_f.x()   * sumf_d_up   - dm_up_f.y()   * sumf_m_up;
+        partial_gate += dm_gate_f.x() * sumf_d_gate - dm_gate_f.y() * sumf_m_gate;
+    }
