+        const sycl::half2 * q8_1_ds_ptr    = (const sycl::half2 *) ((const char *) vy + ncols_t + iby * sizeof(sycl::half2));
+
+        partial_up   += reorder_vec_dot_q_sycl()(vup,   bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+        partial_gate += reorder_vec_dot_q_sycl()(vgate, bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+    }
+
+    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        partial_up   += dpct::permute_sub_group_by_xor(sg, partial_up,   mask);
+        partial_gate += dpct::permute_sub_group_by_xor(sg, partial_gate, mask);
+    }
+    if (item_ct1.get_local_id(2) == 0) {
+        float * dst = (float *) ((char *) dst_base + (size_t) row * dst_row_stride);
+        *dst = partial_up * (partial_gate / (1.0f + sycl::native::exp(-partial_gate)));
+    }
