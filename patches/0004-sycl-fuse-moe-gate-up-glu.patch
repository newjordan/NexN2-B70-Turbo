+static bool ggml_sycl_same_type_shape_stride(const ggml_tensor * a, const ggml_tensor * b) {
+    return a->type == b->type && ggml_are_same_shape(a, b) && ggml_are_same_stride(a, b);
+}
+
+static bool ggml_sycl_fusion_memory_ranges_ok(const ggml_cgraph * cgraph, int node_idx, int node_count, int out_node_idx) {
+    auto nodes_overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const uintptr_t a_start = (uintptr_t) a->data;
+        const uintptr_t a_end   = a_start + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+        const uintptr_t b_start = (uintptr_t) b->data;
+        const uintptr_t b_end   = b_start + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+        return (b_start <= a_start && a_start < b_end) || (a_start <= b_start && b_start < a_end);
+    };
+
+    const ggml_tensor * dst = cgraph->nodes[out_node_idx];
+    for (int j = node_idx; j < node_idx + node_count; ++j) {
+        for (int src_idx = 0; src_idx < GGML_MAX_SRC; ++src_idx) {
+            const ggml_tensor * src = cgraph->nodes[j]->src[src_idx];
+            if (!src || src->op == GGML_OP_NONE) {
+                continue;
+            }
+            if (!nodes_overlap(dst, src)) {
+                continue;
+            }
+
+            bool is_elided_intermediate = false;
+            for (int k = node_idx; k < j; ++k) {
+                if (cgraph->nodes[k] == src) {
+                    is_elided_intermediate = true;
+                    break;
+                }
+            }
+            if (!is_elided_intermediate) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool ggml_sycl_tensor_matches_cached_q8_src(const ggml_tensor * t, const ggml_tensor * cached) {
+    return t == cached || (t && t->src[0] == cached) || (t && t->view_src == cached);
+}
+
+static bool ggml_sycl_should_fuse_moe_gate_up_swiglu(
+    const ggml_tensor * up, const ggml_tensor * gate, const ggml_tensor * glu) {
+    if (!up || !gate || !glu) {
+        return false;
+    }
+    if (up->op != GGML_OP_MUL_MAT_ID || gate->op != GGML_OP_MUL_MAT_ID || glu->op != GGML_OP_GLU) {
+        return false;
+    }
+    if (glu->src[0] != gate || glu->src[1] != up) {
+        return false;
+    }
+    if (ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU) {
+        return false;
+    }
+    if (const bool swapped = ggml_get_op_params_i32(glu, 1); swapped) {
+        return false;
+    }
+
+    const ggml_tensor * up_w   = up->src[0];
+    const ggml_tensor * gate_w = gate->src[0];
+    const ggml_tensor * src1   = up->src[1];
+    const ggml_tensor * ids    = up->src[2];
+
+    if (!up_w || !gate_w || !src1 || !ids || gate->src[1] != src1 || gate->src[2] != ids) {
+        return false;
+    }
+    if (!ggml_sycl_same_type_shape_stride(up_w, gate_w)) {
+        return false;
+    }
+    if (!ggml_are_same_shape(up, gate) || !ggml_are_same_shape(up, glu)) {
+        return false;
+    }
+    if (up->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || !ggml_is_contiguous(src1)) {
+        return false;
+    }
+    if (src1->ne[0] != up_w->ne[0] || src1->ne[0] % QK8_1 != 0) {
+        return false;
+    }
+    if (ids->ne[1] != 1) {
+        return false;
+    }
+    if (src1->ne[1] != 1 && src1->ne[1] != ids->ne[0]) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_sycl_split(up_w->buffer) || ggml_backend_buffer_is_sycl_split(gate_w->buffer)) {
+        return false;
+    }
+
+    switch (up_w->type) {
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool ggml_sycl_moe_gate_up_swiglu_reorder_fused(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * up,
+    const ggml_tensor * gate, ggml_tensor * glu) {
+    if (!ggml_sycl_should_fuse_moe_gate_up_swiglu(up, gate, glu)) {
+        return false;
+    }
+
+    const ggml_tensor * up_w   = up->src[0];
+    const ggml_tensor * gate_w = gate->src[0];
+    const ggml_tensor * src1   = up->src[1];
+    const ggml_tensor * ids    = up->src[2];
+
+    opt_for_reorder_id(&ctx, up_w);
+    opt_for_reorder_id(&ctx, gate_w);
+
+    const ggml_tensor_extra_gpu * up_extra   = static_cast<const ggml_tensor_extra_gpu *>(up_w->extra);
+    const ggml_tensor_extra_gpu * gate_extra = static_cast<const ggml_tensor_extra_gpu *>(gate_w->extra);
+    if (!up_extra || !gate_extra ||
+        !up_extra->optimized_feature.reorder || !gate_extra->optimized_feature.reorder) {
+        return false;
+    }
+
+    const int64_t ne10             = src1->ne[0];
+    const int64_t ne11             = src1->ne[1];
+    const int     src1_padded_cols = GGML_PAD((int) ne10, MATRIX_ROW_PADDING);
+    const int     n_experts_used   = (int) ids->ne[0];
+    const int     nrows            = (int) up_w->ne[1];
+    const queue_ptr stream         = ctx.stream();
+
+    const size_t bytes_per_qrow = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+    const size_t src1_q8_size = (size_t) ne11 * bytes_per_qrow;
+    const bool use_cached_q8 =
+        ctx.moe_act_q8 != nullptr &&
+        ctx.moe_act_q8_ne0 == ne10 &&
+        ctx.moe_act_q8_ne1 == ne11 &&
+        ctx.moe_act_q8_row_stride == bytes_per_qrow &&
+        (ggml_sycl_tensor_matches_cached_q8_src(src1, ctx.moe_act_q8_src) ||
+         (g_ggml_sycl_enable_moe_act_q8_cache && ctx.moe_act_q8_src == src1));
+    char * src1_ddq = nullptr;
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool());
+    if (use_cached_q8) {
+        src1_ddq = ctx.moe_act_q8;
+    } else if (g_ggml_sycl_enable_moe_act_q8_cache && ne11 == 1) {
+        if (!ctx.moe_act_q8_alloc) {
+            ctx.moe_act_q8_alloc = std::make_unique<ggml_sycl_pool_alloc<char>>(ctx.pool());
+        }
+        if (!ctx.moe_act_q8 || ctx.moe_act_q8_size < src1_q8_size) {
+            ctx.moe_act_q8 = ctx.moe_act_q8_alloc->realloc(src1_q8_size);
+            ctx.moe_act_q8_size = ctx.moe_act_q8_alloc->actual_size;
+        }
+        src1_ddq = ctx.moe_act_q8;
+    } else {
+        src1_ddq = src1_q8_alloc.alloc(src1_q8_size);
+    }
+    if (!use_cached_q8) {
         quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
             (const float *) src1->data, src1_ddq, (int) ne10, (int) ne11,
             src1_padded_cols, stream);
+    }
+
+    const size_t src1_row_stride = (ne11 == 1) ? 0 : bytes_per_qrow;
+    if (!use_cached_q8 && g_ggml_sycl_enable_moe_act_q8_cache && ne11 == 1 && src1_ddq == ctx.moe_act_q8) {
+        ctx.moe_act_q8_src = src1;
+        ctx.moe_act_q8_ne0 = ne10;
+        ctx.moe_act_q8_ne1 = ne11;
+        ctx.moe_act_q8_row_stride = bytes_per_qrow;
+    }
+
+    if (g_ggml_sycl_enable_moe_gate_up_q8_handoff &&
+        g_ggml_sycl_enable_moe_gate_up_fusion == 3 &&
+        ne10 == 2048 && ne11 == 1 && nrows == 512 && n_experts_used == 8 &&
+        glu->ne[0] == 512 && glu->ne[1] == 8 && glu->ne[2] == 1 && glu->ne[3] == 1) {
+        constexpr int down_cols = 512;
+        constexpr int down_rows = 8;
+        constexpr int down_padded_cols = GGML_PAD(down_cols, MATRIX_ROW_PADDING);
+        const size_t down_q8_row_stride = (size_t) down_padded_cols * sizeof(block_q8_1) / QK8_1;
+        const size_t down_q8_size = down_rows * down_q8_row_stride;
+
+        if (!ctx.moe_gate_up_q8_alloc) {
+            ctx.moe_gate_up_q8_alloc = std::make_unique<ggml_sycl_pool_alloc<char>>(ctx.pool());
+        }
+        if (!ctx.moe_gate_up_q8 || ctx.moe_gate_up_q8_size < down_q8_size) {
+            ctx.moe_gate_up_q8 = ctx.moe_gate_up_q8_alloc->realloc(down_q8_size);
+            ctx.moe_gate_up_q8_size = ctx.moe_gate_up_q8_alloc->actual_size;
+        }
+
+        const bool ok = ggml_sycl_mul_mat_vec_q_id_swiglu_reorder_nx2_q8_handoff(
+            up_w->type, up_w->data, gate_w->data, src1_ddq, (const int32_t *) ids->data,
+            (float *) glu->data, ctx.moe_gate_up_q8, n_experts_used,
+            /*expert_weight_stride=*/ up_w->nb[2],
+            /*dst_row_stride=*/ glu->nb[1],
+            src1_row_stride, down_q8_row_stride, stream);
+        if (ok) {
+            ctx.moe_gate_up_q8_src = glu;
+            ctx.moe_gate_up_q8_row_stride = down_q8_row_stride;
+            return true;
+        }
+        ctx.moe_gate_up_q8_src = nullptr;
+    }
+
+    return ggml_sycl_mul_mat_vec_q_id_swiglu_reorder(
+        up_w->type, up_w->data, gate_w->data, src1_ddq, (const int32_t *) ids->data,
+        (float *) glu->data, (int) ne10, nrows, n_experts_used,
+        /*expert_weight_stride=*/ up_w->nb[2],
+        /*dst_row_stride=*/ glu->nb[1],
+        src1_row_stride, stream);
+}
+
+static bool ggml_sycl_is_nx2_moe_gate_up_swiglu_shape(
+    const ggml_tensor * up, const ggml_tensor * gate, const ggml_tensor * glu) {
+    if (!ggml_sycl_should_fuse_moe_gate_up_swiglu(up, gate, glu)) {
+        return false;
+    }
+
+    const ggml_tensor * up_w = up->src[0];
+    const ggml_tensor * ids  = up->src[2];
+    return (up_w->type == GGML_TYPE_Q4_K || up_w->type == GGML_TYPE_Q5_K) &&
+        up_w->ne[0] == 2048 && up_w->ne[1] == 512 && ids->ne[0] == 8;
+}
+
+static bool ggml_sycl_moe_gate_up_shared_q8_reorder_fused(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * up,
+    const ggml_tensor * gate, const ggml_tensor * glu) {
+    if (!ggml_sycl_should_fuse_moe_gate_up_swiglu(up, gate, glu)) {
+        return false;
+    }
+
+    const ggml_tensor * up_w   = up->src[0];
+    const ggml_tensor * gate_w = gate->src[0];
+    const ggml_tensor * src1   = up->src[1];
+    const ggml_tensor * ids    = up->src[2];
+
+    opt_for_reorder_id(&ctx, up_w);
+    opt_for_reorder_id(&ctx, gate_w);
+
+    const ggml_tensor_extra_gpu * up_extra   = static_cast<const ggml_tensor_extra_gpu *>(up_w->extra);
+    const ggml_tensor_extra_gpu * gate_extra = static_cast<const ggml_tensor_extra_gpu *>(gate_w->extra);
+    if (!up_extra || !gate_extra ||
+        !up_extra->optimized_feature.reorder || !gate_extra->optimized_feature.reorder) {
+        return false;
+    }
+
+    const int64_t ne10             = src1->ne[0];
+    const int64_t ne11             = src1->ne[1];
+    const int     src1_padded_cols = GGML_PAD((int) ne10, MATRIX_ROW_PADDING);
+    const int     n_experts_used   = (int) ids->ne[0];
+    const int     nrows            = (int) up_w->ne[1];
+    const queue_ptr stream         = ctx.stream();
+
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+        (size_t) ne11 * src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * src1_ddq = src1_q8_alloc.get();
+    quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+        (const float *) src1->data, src1_ddq, (int) ne10, (int) ne11,
+        src1_padded_cols, stream);
+
+    const size_t bytes_per_qrow = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+    const size_t src1_row_stride = (ne11 == 1) ? 0 : bytes_per_qrow;
+
+    const bool gate_ok = ggml_sycl_mul_mat_vec_q_id_reorder(
+        gate_w->type, gate_w->data, src1_ddq, (const int32_t *) ids->data,
+        (float *) gate->data, (int) ne10, nrows, n_experts_used,
+        /*expert_weight_stride=*/ gate_w->nb[2],
+        /*dst_row_stride=*/ gate->nb[1],
+        src1_row_stride, stream);
+    const bool up_ok = ggml_sycl_mul_mat_vec_q_id_reorder(
+        up_w->type, up_w->data, src1_ddq, (const int32_t *) ids->data,
+        (float *) up->data, (int) ne10, nrows, n_experts_used,
+        /*expert_weight_stride=*/ up_w->nb[2],
+        /*dst_row_stride=*/ up->nb[1],
+        src1_row_stride, stream);
+
+    return gate_ok && up_ok;
+}
+
+static int ggml_sycl_try_fuse_moe_gate_up_glu(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_gate_up_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx,
+            { GGML_OP_MUL_MAT_ID, GGML_OP_MUL_MAT_ID, GGML_OP_GLU }, { node_idx + 2 })) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 3, node_idx + 2)) {
+        return 0;
+    }
+
+    ggml_tensor * glu  = cgraph->nodes[node_idx + 2];
+    ggml_tensor * gate = glu->src[0];
+    ggml_tensor * up   = glu->src[1];
+    const bool ordered =
+        (gate == cgraph->nodes[node_idx] && up == cgraph->nodes[node_idx + 1]) ||
+        (gate == cgraph->nodes[node_idx + 1] && up == cgraph->nodes[node_idx]);
+    if (!ordered) {
+        return 0;
+    }
+
+    if (g_ggml_sycl_enable_moe_gate_up_fusion == 2) {
+        return ggml_sycl_moe_gate_up_shared_q8_reorder_fused(ctx, up, gate, glu) ? 1 : 0;
+    }
+    if (g_ggml_sycl_enable_moe_gate_up_fusion == 3 &&
+        !ggml_sycl_is_nx2_moe_gate_up_swiglu_shape(up, gate, glu)) {
+        return 0;
+    }
+    return ggml_sycl_moe_gate_up_swiglu_reorder_fused(ctx, up, gate, glu) ? 2 : 0;
+}
+
+static bool ggml_sycl_should_fuse_moe_shared_gate_up_swiglu(
+    const ggml_tensor * up, const ggml_tensor * gate, const ggml_tensor * glu) {
+    if (!up || !gate || !glu) {
+        return false;
+    }
+    if (up->op != GGML_OP_MUL_MAT || gate->op != GGML_OP_MUL_MAT || glu->op != GGML_OP_GLU) {
+        return false;
+    }
+    if (glu->src[0] != gate || glu->src[1] != up) {
+        return false;
+    }
+    if (ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU) {
+        return false;
+    }
+    if (const bool swapped = ggml_get_op_params_i32(glu, 1); swapped) {
+        return false;
+    }
+
+    const ggml_tensor * up_w   = up->src[0];
+    const ggml_tensor * gate_w = gate->src[0];
+    const ggml_tensor * src1   = up->src[1];
+
+    if (!up_w || !gate_w || !src1 || gate->src[1] != src1) {
+        return false;
+    }
+    if (!ggml_sycl_same_type_shape_stride(up_w, gate_w)) {
+        return false;
+    }
+    if (!ggml_are_same_shape(up, gate) || !ggml_are_same_shape(up, glu)) {
+        return false;
+    }
+    if (up->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || !ggml_is_contiguous(src1) ||
+        src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+    if (src1->ne[0] != 2048 || up_w->ne[0] != 2048 || up_w->ne[1] != 512) {
+        return false;
+    }
+    if (up->ne[0] != 512 || up->ne[1] != 1 || up->ne[2] != 1 || up->ne[3] != 1) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_sycl_split(up_w->buffer) || ggml_backend_buffer_is_sycl_split(gate_w->buffer)) {
+        return false;
+    }
+
+    return up_w->type == GGML_TYPE_Q4_K || up_w->type == GGML_TYPE_Q5_K;
+}
+
+static bool ggml_sycl_moe_shared_gate_up_swiglu_reorder_fused(
+    ggml_backend_sycl_context & ctx, ggml_tensor * up,
+    ggml_tensor * gate, ggml_tensor * glu) {
+    if (!ggml_sycl_should_fuse_moe_shared_gate_up_swiglu(up, gate, glu)) {
+        return false;
+    }
+
+    const ggml_tensor * up_w   = up->src[0];
+    const ggml_tensor * gate_w = gate->src[0];
+    const ggml_tensor * src1   = up->src[1];
+
+    opt_for_reorder(&ctx, up_w, src1, up, mul_mat_algo::MMVQ);
+    opt_for_reorder(&ctx, gate_w, src1, gate, mul_mat_algo::MMVQ);
+
+    const ggml_tensor_extra_gpu * up_extra   = static_cast<const ggml_tensor_extra_gpu *>(up_w->extra);
+    const ggml_tensor_extra_gpu * gate_extra = static_cast<const ggml_tensor_extra_gpu *>(gate_w->extra);
+    if (!up_extra || !gate_extra ||
+        !up_extra->optimized_feature.reorder || !gate_extra->optimized_feature.reorder) {
+        return false;
+    }
+
+    constexpr int ne10             = 2048;
+    constexpr int src1_padded_cols = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const queue_ptr stream         = ctx.stream();
+
+    const size_t bytes_per_qrow = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+    const bool use_cached_q8 =
+        g_ggml_sycl_enable_moe_act_q8_cache &&
+        ctx.moe_act_q8_src == src1 &&
+        ctx.moe_act_q8 != nullptr &&
+        ctx.moe_act_q8_ne0 == ne10 &&
+        ctx.moe_act_q8_ne1 == 1 &&
+        ctx.moe_act_q8_row_stride == bytes_per_qrow;
+
+    char * src1_ddq = nullptr;
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool());
+    if (use_cached_q8) {
+        src1_ddq = ctx.moe_act_q8;
+    } else {
+        src1_ddq = src1_q8_alloc.alloc(bytes_per_qrow);
+        quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+            (const float *) src1->data, src1_ddq, ne10, 1, src1_padded_cols, stream);
+    }
+
+    return ggml_sycl_mul_mat_vec_q_swiglu_reorder_nx2(
+        up_w->type, up_w->data, gate_w->data, src1_ddq,
+        (float *) glu->data, glu->nb[0], stream);
+}
+
+static int ggml_sycl_try_fuse_moe_shared_gate_up_glu(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_moe_shared_gate_up_fusion || g_ggml_sycl_disable_optimize) {
+        return 0;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx,
+            { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU }, { node_idx + 2 })) {
+        return 0;
+    }
+    if (!ggml_sycl_fusion_memory_ranges_ok(cgraph, node_idx, 3, node_idx + 2)) {
+        return 0;
+    }
+
+    ggml_tensor * glu  = cgraph->nodes[node_idx + 2];
+    ggml_tensor * gate = glu->src[0];
+    ggml_tensor * up   = glu->src[1];
+    const bool ordered =
+        (gate == cgraph->nodes[node_idx] && up == cgraph->nodes[node_idx + 1]) ||
+        (gate == cgraph->nodes[node_idx + 1] && up == cgraph->nodes[node_idx]);
+    if (!ordered) {
+        return 0;
+    }
+
+    return ggml_sycl_moe_shared_gate_up_swiglu_reorder_fused(ctx, up, gate, glu) ? 2 : 0;
+}
+
+static bool ggml_sycl_moe_weighted_sum_view_index(
+    const ggml_tensor * view, const ggml_tensor * weighted, bool seen[8]) {
+    if (!view || view->view_src != weighted || view->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (view->ne[0] != 2048 || view->ne[1] != 1 || view->ne[2] != 1 || view->ne[3] != 1) {
+        return false;
+    }
+    if (view->nb[0] != (int64_t) sizeof(float) || weighted->nb[1] != 2048 * (int64_t) sizeof(float)) {
+        return false;
+    }
+    if (view->view_offs % weighted->nb[1] != 0) {
+        return false;
+    }
+
+    const int expert = (int) (view->view_offs / weighted->nb[1]);
+    if (expert < 0 || expert >= 8 || seen[expert]) {
+        return false;
+    }
+    seen[expert] = true;
+    return true;
+}
+
+static bool ggml_sycl_moe_down_weighted_sum_fused(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * down,
+    const ggml_tensor * weights, ggml_tensor * dst) {
+    const ggml_tensor * down_w = down->src[0];
+    const ggml_tensor * src1   = down->src[1];
+    const ggml_tensor * ids    = down->src[2];
+    if (!down_w || !src1 || !ids || !weights) {
+        return false;
+    }
+    if (down_w->type != GGML_TYPE_Q6_K || ggml_backend_buffer_is_sycl_split(down_w->buffer)) {
+        return false;
+    }
+    if (down_w->ne[0] != 512 || down_w->ne[1] != 2048 ||
+        src1->type != GGML_TYPE_F32 || src1->ne[0] != 512 || src1->ne[1] != 8 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 || !ggml_is_contiguous(src1)) {
+        return false;
+    }
+    if (ids->ne[0] != 8 || ids->ne[1] != 1 ||
+        weights->type != GGML_TYPE_F32 || weights->ne[0] != 1 || weights->ne[1] != 8 ||
+        weights->ne[2] != 1 || weights->ne[3] != 1 ||
+        weights->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+    if (!dst || dst->type != GGML_TYPE_F32 || dst->ne[0] != 2048 || dst->ne[1] != 1 ||
+        dst->ne[2] != 1 || dst->ne[3] != 1 || dst->nb[0] != (int64_t) sizeof(float)) {
+        return false;
+    }
+
+    opt_for_reorder_id(&ctx, down_w);
+    const ggml_tensor_extra_gpu * down_extra =
+        static_cast<const ggml_tensor_extra_gpu *>(down_w->extra);
+    if (!down_extra || !down_extra->optimized_feature.reorder) {
+        return false;
+    }
+
+    constexpr int ne10             = 512;
+    constexpr int ne11             = 8;
+    constexpr int src1_padded_cols = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const queue_ptr stream         = ctx.stream();
+
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+        (size_t) ne11 * src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * src1_ddq = src1_q8_alloc.get();
+    quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+        (const float *) src1->data, src1_ddq, ne10, ne11, src1_padded_cols, stream);
+
+    const size_t bytes_per_qrow = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+    if (g_ggml_sycl_enable_moe_down_weighted_sum_fusion == 2) {
+        return ggml_sycl_mul_mat_vec_q_id_reorder_down_weighted_sum_atomic(
+            down_w->type, down_w->data, src1_ddq, (const int32_t *) ids->data,
+            weights->data, (float *) dst->data,
+            /*expert_weight_stride=*/ down_w->nb[2],
+            /*src1_row_stride=*/ bytes_per_qrow,
+            /*weights_row_stride=*/ weights->nb[1],
+            stream);
+    }
+    if (g_ggml_sycl_enable_moe_down_weighted_sum_fusion == 3) {
+        return ggml_sycl_mul_mat_vec_q_id_reorder_down_weighted_sum_local(
+            down_w->type, down_w->data, src1_ddq, (const int32_t *) ids->data,
+            weights->data, (float *) dst->data,
+            /*expert_weight_stride=*/ down_w->nb[2],
+            /*src1_row_stride=*/ bytes_per_qrow,
+            /*weights_row_stride=*/ weights->nb[1],
+            stream);
+    }
+
+    return ggml_sycl_mul_mat_vec_q_id_reorder_down_weighted_sum(
+        down_w->type, down_w->data, src1_ddq, (const int32_t *) ids->data,
+        weights->data, (float *) dst->data,
+        /*expert_weight_stride=*/ down_w->nb[2],
+        /*src1_row_stride=*/ bytes_per_qrow,
+        /*weights_row_stride=*/ weights->nb[1],
+        stream);
+}
