     ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(src0->extra);
@@ -4347,6 +4400,54 @@ static bool ggml_sycl_mul_mat_id_mmvq_fused(
         src1_row_stride, stream);
 }
 
+// Graph-safety mirror of ggml_sycl_mul_mat_id_mmvq_fused: true when this MUL_MAT_ID node will
+// take the fused TG path with no host synchronization, so it can record into a SYCL graph. The
+// fallback per-expert loop host-syncs on the ids memcpy and must keep graphs disabled. The
+// one-time lazy expert reorder (temp alloc + full-tensor memcpy) must also stay out of
+// recordings: until it has run -- triggered by the first eager pass -- a reorder-eligible
+// tensor reports unsafe.
+static bool ggml_sycl_mul_mat_id_is_graph_safe(ggml_backend_sycl_context * ctx, const ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+
+    // bail checks of ggml_sycl_mul_mat_id_mmvq_fused
+    if (src1->ne[2] != 1) return false;
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (src1->ne[0] != src0->ne[0] || src1->ne[0] % QK8_1 != 0) return false;
+    if (!ggml_is_contiguous(src1)) return false;
+    if (ids->ne[1] != 1) return false;
+    if (src1->ne[1] != 1 && src1->ne[1] != ids->ne[0]) return false;
+
+    switch (src0->type) {  // mirrors the ggml_sycl_mul_mat_vec_q_id type dispatch
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_NVFP4:
+            break;
+        default:
+            return false;
+    }
+
+    // would opt_for_reorder_id still mutate this tensor? then the eager pass must run it first
+    if (!g_ggml_sycl_disable_optimize && ctx->opt_feature.reorder &&
+        (src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q5_K || src0->type == GGML_TYPE_Q6_K)) {
+        const ggml_tensor_extra_gpu * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (extra && !extra->optimized_feature.reorder) {
+            return false;
+        }
+    }
+    return true;
+}
