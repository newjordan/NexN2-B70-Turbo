             case GGML_OP_MUL_MAT_ID:
-                // ggml_sycl_mul_mat_id() does a blocking host wait on the sycl queue after
-                // submitting a memcpy operation, but wait() can't be called on a queue that
-                // is recording to a graph.
+                // The fused MoE TG path keeps the routing ids on-device and never host-syncs,
+                // so it can record into a graph; its pool allocations need the async alloc
+                // extension, same as GGML_OP_MUL_MAT below. Only the fallback per-expert loop
+                // (blocking ids memcpy) and the one-time lazy expert reorder require graphs off.
+                if (g_ggml_sycl_use_async_mem_op &&
+                    ggml_sycl_mul_mat_id_is_graph_safe(sycl_ctx, cgraph->nodes[i])) {
+                    break;
+                }
                 GGML_LOG_INFO("%s: disabling SYCL graphs due to unsupported node type %s\n", __func__,
                               ggml_op_name(node_op));
                 return false;
@@ -5162,7 +5263,7 @@ static ggml_status ggml_backend_sycl_graph_compute(ggml_backend_t backend, ggml_
     auto * sycl_ctx = static_cast<ggml_backend_sycl_context *>(backend->context);
 
 #ifdef GGML_SYCL_GRAPH
-    bool use_sycl_graph = !g_ggml_sycl_disable_graph && check_graph_compatibility(cgraph);
+    bool use_sycl_graph = !g_ggml_sycl_disable_graph && check_graph_compatibility(sycl_ctx, cgraph);
     if (use_sycl_graph) {
         const bool graph_support = dpct::get_device(sycl_ctx->device).has(sycl::aspect::ext_oneapi_limited_graph);
         if (!graph_support) {
