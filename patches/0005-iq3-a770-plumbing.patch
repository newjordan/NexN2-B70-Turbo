diff --git a/ggml/src/ggml-common.h b/ggml/src/ggml-common.h
index f05683b44..2fed8438a 100644
--- a/ggml/src/ggml-common.h
+++ b/ggml/src/ggml-common.h
@@ -310,6 +310,18 @@ typedef struct {
 } block_q3_K;
 static_assert(sizeof(block_q3_K) == sizeof(ggml_half) + QK_K / 4 + QK_K / 8 + 12, "wrong q3_K block size/padding");
 
+// A770 codebook-free 3-bit quantization.
+// Same qs/hmask packing as Q3_K, but 8 sub-blocks of 32 with 4-bit signed scales.
+// weight is represented as x = d * sc * q, with sc in [-8,7] and q in [-4,3]
+// Effectively 3.1875 bits per weight
+typedef struct {
+    uint8_t hmask[QK_K/8]; // quants - high bit
+    uint8_t qs[QK_K/4];    // quants - low 2 bits
+    uint8_t scales[4];     // 8 sub-block scales, quantized with 4 bits
+    ggml_half d;           // super-block scale
+} block_iq3_a770;
+static_assert(sizeof(block_iq3_a770) == sizeof(ggml_half) + QK_K / 4 + QK_K / 8 + 4, "wrong iq3_a770 block size/padding");
+
 // 4-bit quantization
 // 8 blocks of 32 elements each
 // weight is represented as x = a * q + b
