diff --git a/tests/iq3_a770_oracle_check.c b/tests/iq3_a770_oracle_check.c
new file mode 100644
index 000000000..74c57fd13
--- /dev/null
+++ b/tests/iq3_a770_oracle_check.c
@@ -0,0 +1,80 @@
+// Standalone correctness check for the IQ3_A770 CPU oracle (patch 0005).
+// Validates: (1) vec_dot(xq, q8(a)) == dequant(xq) . dequant_q8(a)  [vec_dot is exact
+// w.r.t. the quantized representation], and (2) quantization round-trip error is sane.
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+
+extern void quantize_row_iq3_a770_ref(const float * x, void * y, int64_t k);
+extern void dequantize_row_iq3_a770(const void * x, float * y, int64_t k);
+extern void quantize_row_q8_K_ref(const float * x, void * y, int64_t k);
+extern void dequantize_row_q8_K(const void * x, float * y, int64_t k);
+extern void ggml_vec_dot_iq3_a770_q8_K(int n, float * s, size_t bs,
+        const void * vx, size_t bx, const void * vy, size_t by, int nrc);
+extern void quantize_row_q3_K_ref(const float * x, void * y, int64_t k);
+extern void ggml_vec_dot_q3_K_q8_K(int n, float * s, size_t bs,
+        const void * vx, size_t bx, const void * vy, size_t by, int nrc);
+
+// init the CPU backend so ggml_table_f32_f16 (used by the CPU vec_dot) is populated
+extern void ggml_cpu_init(void);
+
+static float frand(void) { return 2.0f*((float)rand()/(float)RAND_MAX) - 1.0f; }
+
+int main(void) {
+    const int64_t K = 4096;            // 16 super-blocks of 256
+    const int64_t nblk = K/256;
+    float * x   = malloc(K*sizeof(float));
+    float * a   = malloc(K*sizeof(float));
+    float * xdq = malloc(K*sizeof(float));
+    float * adq = malloc(K*sizeof(float));
+    unsigned char * xq = malloc(nblk*102);   // block_iq3_a770 = 102 B
+    unsigned char * aq = malloc(nblk*512);   // block_q8_K ~292 B, allocate generously
+
+    ggml_cpu_init();
+
+    srand(1234);
+    // weights: gaussian-ish; activations: uniform
+    for (int64_t i = 0; i < K; ++i) { x[i] = frand()*0.35f + 0.10f*frand(); a[i] = frand(); }
+
+    quantize_row_iq3_a770_ref(x, xq, K);
+    dequantize_row_iq3_a770(xq, xdq, K);
+    quantize_row_q8_K_ref(a, aq, K);
+    dequantize_row_q8_K(aq, adq, K);
+
+    // debug: inspect raw q8_K block 0 (layout: float d; int8 qs[256]; int16 bsums[16])
+    printf("[dbg] q8_K[0].d = %.6f  qs[0..3]= %d %d %d %d\n",
+        *(float*)aq, ((signed char*)aq)[4], ((signed char*)aq)[5], ((signed char*)aq)[6], ((signed char*)aq)[7]);
+    printf("[dbg] adq[0..3] = %.4f %.4f %.4f %.4f   a[0..3]= %.4f %.4f %.4f %.4f\n",
+        adq[0],adq[1],adq[2],adq[3], a[0],a[1],a[2],a[3]);
+
+    float dot_vecdot = 0.0f;
+    ggml_vec_dot_iq3_a770_q8_K((int)K, &dot_vecdot, 0, xq, 0, aq, 0, 1);
+
+    // control: Q3_K through the identical harness
+    unsigned char * xq3 = malloc(nblk*110);
+    float * xdq3 = malloc(K*sizeof(float));
+    quantize_row_q3_K_ref(x, xq3, K);
+    float dot_q3 = 0.0f;
+    ggml_vec_dot_q3_K_q8_K((int)K, &dot_q3, 0, xq3, 0, aq, 0, 1);
+    printf("[control] q3_K vec_dot = %.6f\n", dot_q3);
+
+    double dot_ref = 0.0;
+    for (int64_t i = 0; i < K; ++i) dot_ref += (double)xdq[i]*(double)adq[i];
+
+    // round-trip quantization error of the weights
+    double se = 0.0, s2 = 0.0;
+    for (int64_t i = 0; i < K; ++i) { double e = (double)x[i]-(double)xdq[i]; se += e*e; s2 += (double)x[i]*(double)x[i]; }
+    double nrmse = sqrt(se/s2);
+
+    double rel = fabs(dot_ref) > 1e-9 ? fabs(dot_vecdot - dot_ref)/fabs(dot_ref) : fabs(dot_vecdot - dot_ref);
+
+    printf("vec_dot       = %.6f\n", dot_vecdot);
+    printf("dequant.dot   = %.6f\n", dot_ref);
+    printf("rel diff      = %.3e   (vec_dot vs dequant-then-dot; should be ~0)\n", rel);
+    printf("weight NRMSE  = %.4f   (3-bit round-trip; sane if < ~0.25)\n", nrmse);
+
+    int ok = (rel < 1e-3) && (nrmse < 0.30) && isfinite(dot_vecdot);
+    printf("%s\n", ok ? "ORACLE CHECK: PASS" : "ORACLE CHECK: FAIL");
+    return ok ? 0 : 1;
+}
