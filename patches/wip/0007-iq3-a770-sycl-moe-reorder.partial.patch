+template<typename dst_t>
+static void dequantize_block_iq3_a770(const void * __restrict__ vx, dst_t * __restrict__ yy,
+                                      const sycl::nd_item<3> &item_ct1) {
+    // Codebook-free 3-bit (A770). Same qs/hmask bit-packing as Q3_K, but 8 sub-blocks
+    // of 32 with 4-bit signed scales (nibble-8), and a non-uniform 8-entry LUT
+    // (kvalues_iq3nl): x = d * sc * kv[L], L = (qs 2 low bits) | (hmask high bit << 2).
+    const int64_t i = item_ct1.get_group(2);
+    const block_iq3_a770 * x = (const block_iq3_a770 *) vx;
+    const int8_t * kv = kvalues_iq3nl;
+
+    const int64_t r   = item_ct1.get_local_id(2) / 4;
+    const int64_t tid = r / 2;
+    const int64_t is0 = r % 2;
+    const int64_t l0  = 16 * is0 + 4 * (item_ct1.get_local_id(2) % 4);
+    const int64_t n   = tid / 4;
+    const int64_t j   = tid - 4 * n;
+
+    const uint8_t m     = 1 << (4 * n + j);
+    const int     shift = 2 * j;
+    const int64_t is    = 4 * n + j;   // sub-block of 32 (0..7)
+
+    const int8_t sc    = (int8_t)((x[i].scales[is >> 1] >> (4 * (is & 1))) & 0xF) - 8;
+    const float  d_all = x[i].d;
+    const float  dl    = d_all * sc;
+
+    dst_t * y = yy + i * QK_K + 128 * n + 32 * j;
+    const uint8_t * q  = x[i].qs + 32 * n;
+    const uint8_t * hm = x[i].hmask;
+
+    for (int l = l0; l < l0 + 4; ++l) {
+        const int L = ((q[l] >> shift) & 3) | ((hm[l] & m) ? 4 : 0);
+        y[l] = dl * kv[L];
+    }
