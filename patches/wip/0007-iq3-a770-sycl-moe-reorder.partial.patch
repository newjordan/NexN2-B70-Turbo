+// MoE counterpart for IQ3_A770: scatter every block of every expert into its per-expert self-contained
+// SoA ([qs][hmask][scales][d]). Same atomic temp-buffer contract as reorder_qw_q6_k_moe. The plane
+// order/sizes must match block_q_t<IQ3_A770> and dequantize_block_iq3_a770_reorder exactly.
+static bool reorder_qw_iq3_a770_moe(uint8_t * data_device, size_t expert_bytes, int64_t n_expert, dpct::queue_ptr stream) {
+    GGML_ASSERT(expert_bytes % sizeof(block_iq3_a770) == 0);
+    const int    blocks_per_expert = (int) (expert_bytes / sizeof(block_iq3_a770));
+    const size_t total_bytes       = expert_bytes * (size_t) n_expert;
+
+    sycl_reorder_temp_buffer tmp(stream, total_bytes);
+    if (!tmp) {
+        GGML_LOG_WARN("%s: failed to allocate %zu bytes for reorder temp buffer, skipping reorder\n", __func__, total_bytes);
+        return false;
+    }
+    uint8_t * tmp_buf = static_cast<uint8_t *>(tmp.ptr);
+
+    sycl::event copy_event;
+    SYCL_CHECK(CHECK_TRY_ERROR(copy_event = stream->memcpy(tmp_buf, data_device, total_bytes)));
+    if (!g_ggml_sycl_use_async_mem_op) {
+        copy_event.wait();
+    }
+
+    const int total_blocks = blocks_per_expert * (int) n_expert;
+    auto reorder_event = stream->parallel_for(total_blocks, [=](auto gb_) {
+        const int              gb   = gb_;
+        const int              e    = gb / blocks_per_expert;
+        const int              ib   = gb % blocks_per_expert;
+        const block_iq3_a770 * x    = (const block_iq3_a770 *) (tmp_buf + (size_t) e * expert_bytes);
+        uint8_t *              base = data_device + (size_t) e * expert_bytes;
+
+        auto * qs_ptr     = base;
+        auto * hmask_ptr  = qs_ptr + (QK_K / 4) * blocks_per_expert;
+        auto * scales_ptr = hmask_ptr + (QK_K / 8) * blocks_per_expert;
+        auto * d_ptr      = (sycl::half *) (scales_ptr + 4 * blocks_per_expert);
+
+        for (int j = 0; j < QK_K / 4; ++j) {
+            qs_ptr[ib * (QK_K / 4) + j] = x[ib].qs[j];
+        }
+        for (int j = 0; j < QK_K / 8; ++j) {
+            hmask_ptr[ib * (QK_K / 8) + j] = x[ib].hmask[j];
+        }
+        for (int j = 0; j < 4; ++j) {
+            scales_ptr[ib * 4 + j] = x[ib].scales[j];
+        }
+        d_ptr[ib] = x[ib].d;
+    });
+    if (!g_ggml_sycl_use_async_mem_op) {
+        reorder_event.wait_and_throw();
+    }
+    return true;
+}
