+void llama_model_loader::select_tensor_variant() {
+    // The file may carry sibling tensor variants named "<name>.v<N>" (N >= 1); variant 0 is the
+    // canonical (unsuffixed) tensor. Exactly one variant is loaded per run. The selected index is
+    // general.tensor_variant.default and is overridable with --override-kv. Absent that key this
+    // returns immediately, so ordinary single-precision models are untouched.
+    uint32_t variant = 0;
+    if (!get_key(std::string("general.tensor_variant.default"), variant, /* required */ false)) {
+        return;
+    }
+
+    const std::string suffix = variant == 0 ? std::string() : ".v" + std::to_string(variant);
+
+    // group the sibling variants by their canonical (suffix-stripped) base name
+    static const std::regex re_variant(R"(^(.+)\.v([1-9][0-9]*)$)");
+    std::map<std::string, std::vector<std::string>> groups;
+    for (const auto & it : weights_map) {
+        std::smatch m;
+        if (std::regex_match(it.first, m, re_variant)) {
+            groups[m[1].str()].push_back(it.first);
+        }
+    }
+    if (groups.empty()) {
+        LLAMA_LOG_WARN("%s: general.tensor_variant.default=%u is set but the file has no '<name>.v<N>' tensors\n",
+            __func__, variant);
+        return;
+    }
+    for (auto & g : groups) {
+        if (weights_map.count(g.first)) {
+            g.second.push_back(g.first); // include the canonical (variant 0) member, if present
+        }
+    }
+
+    size_t n_dropped = 0;
+    for (const auto & g : groups) {
+        const std::string & base = g.first;
+        const std::string   want = base + suffix;
+
+        const auto it = weights_map.find(want);
+        if (it == weights_map.end()) {
+            throw std::runtime_error(format("%s: requested tensor variant %u, but '%s' is missing from the file",
+                __func__, variant, want.c_str()));
+        }
+
+        llama_tensor_weight w = it->second;       // keep the selected weight (its file offset + meta)
+        for (const auto & name : g.second) {
+            weights_map.erase(name);              // drop every variant of this base
+        }
+        ggml_set_name(w.tensor, base.c_str());    // meta name -> canonical (create_tensor copies it onto the loaded tensor)
+        weights_map.emplace(base, w);             // re-bind the selected weight under the canonical name
+        n_dropped += g.second.size() - 1;
+    }
+
+    n_tensors = (int) weights_map.size();
+    LLAMA_LOG_INFO("%s: multi-precision model: selected tensor variant %u (%s); %zu groups, dropped %zu sibling tensors\n",
+        __func__, variant, suffix.empty() ? "canonical" : suffix.c_str(), groups.size(), n_dropped);
+}
